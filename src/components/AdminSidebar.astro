---
// src/components/AdminSidebar.astro
const pathname = Astro.url.pathname;
---

<aside class="admin-sidebar" id="sidebar">
  <div class="sidebar-top">
    <button id="sidebarToggle" class="sidebar-toggle" title="Toggle Sidebar">
      <span class="toggle-icon">☰</span>
    </button>
  </div>

  <div class="sidebar-header">
    <div class="logo-icon">✦</div>
    <h2 class="sidebar-text">Peniel Admin</h2>
  </div>

  <nav class="sidebar-nav">
    <a href="/admin" class={`nav-item ${pathname === '/admin' || pathname === '/admin/' ? 'active' : ''}`} title="Dashboard">
      <span class="icon">📊</span>
      <span class="sidebar-text">Dashboard</span>
    </a>
    <a href="/admin/products" class={`nav-item ${pathname.includes('/admin/products') ? 'active' : ''}`} title="All Products">
      <span class="icon">📦</span>
      <span class="sidebar-text">All Products</span>
    </a>
    <a href="/admin/add-product" class={`nav-item ${pathname.includes('/admin/add-product') ? 'active' : ''}`} title="Add Product">
      <span class="icon">➕</span>
      <span class="sidebar-text">Add Product</span>
    </a>
    <a href="/admin/categories" class={`nav-item ${pathname.includes('/admin/categories') ? 'active' : ''}`} title="Categories">
      <span class="icon">📁</span>
      <span class="sidebar-text">Categories</span>
    </a>
    <a href="/admin/brands" class={`nav-item ${pathname.includes('/admin/brands') ? 'active' : ''}`} title="Brands">
      <span class="icon">🏷️</span>
      <span class="sidebar-text">Brands</span>
    </a>
    <a href="/admin/units" class={`nav-item ${pathname.includes('/admin/units') ? 'active' : ''}`} title="Product Units">
      <span class="icon">📏</span>
      <span class="sidebar-text">Product Units</span>
    </a>
  </nav>

  <div class="sidebar-footer">
    <a href="/" class="nav-item back-link" title="Back to Store">
      <span class="icon">←</span>
      <span class="sidebar-text">Back to Store</span>
    </a>
  </div>
</aside>

<script is:inline>
  function initSidebar() {
    const sidebar = document.getElementById('sidebar');
    const toggle = document.getElementById('sidebarToggle');
    const layout = document.querySelector('.admin-layout');
    
    if (!sidebar || !toggle) return;

    // Apply saved state immediately
    const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
    if (isCollapsed) {
      sidebar.classList.add('collapsed');
      layout?.classList.add('sidebar-collapsed');
    } else {
      sidebar.classList.remove('collapsed');
      layout?.classList.remove('sidebar-collapsed');
    }

    // Use a direct onclick to avoid multiple event listener issues
    toggle.onclick = (e) => {
      e.preventDefault();
      const currentlyCollapsed = sidebar.classList.toggle('collapsed');
      if (layout) {
        layout.classList.toggle('sidebar-collapsed', currentlyCollapsed);
      }
      localStorage.setItem('sidebar-collapsed', currentlyCollapsed);
    };
  }

  // Initialize on load
  initSidebar();

  // Support Astro View Transitions
  document.addEventListener('astro:after-swap', initSidebar);
  document.addEventListener('astro:page-load', initSidebar);
</script>

<style>
  .admin-sidebar {
    width: 280px;
    height: 100vh;
    position: sticky;
    top: 0;
    background: rgba(13, 15, 20, 0.98);
    backdrop-filter: blur(20px);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    z-index: 50;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  .admin-sidebar.collapsed {
    width: 80px;
    padding-top: 1.5rem;
  }

  .sidebar-top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1rem;
    height: 32px;
  }

  .sidebar-toggle {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .collapsed .sidebar-top {
    justify-content: center;
  }

  .sidebar-toggle:hover {
    background: rgba(197, 160, 40, 0.2);
    border-color: var(--accent);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    transition: all 0.3s ease;
  }

  .collapsed .sidebar-header {
    margin-bottom: 2rem;
    padding-top: 0.5rem;
  }

  .logo-icon {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, #c5a028, #eab308);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-size: 1.2rem;
    font-weight: bold;
    box-shadow: 0 0 15px rgba(197, 160, 40, 0.3);
  }

  .sidebar-header h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(to right, #fff, #cbd5e1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: opacity 0.3s ease;
  }

  .sidebar-text {
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  .collapsed .sidebar-text {
    opacity: 0;
    pointer-events: none;
    width: 0;
  }

  .collapsed .sidebar-header {
    justify-content: center;
  }

  .collapsed .logo-icon {
    margin-right: 0;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    color: #9ca3af;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .nav-item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
  }

  .nav-item.active {
    background: rgba(197, 160, 40, 0.1);
    color: #c5a028;
    border: 1px solid rgba(197, 160, 40, 0.2);
  }

  .icon {
    font-size: 1.2rem;
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .back-link {
    color: #6b7280;
  }

  .back-link:hover {
    color: #f3f4f6;
  }
</style>
