---
import categoriesData from '../data/categories.json';

// Flatten the hierarchy to get subcategories and sub-subcategories
const marqueeTags = [];
Object.entries(categoriesData).forEach(([catKey, subCats]) => {
  if (catKey === 'Brands') return; // Skip Brands

  if (typeof subCats === 'object' && subCats !== null && !Array.isArray(subCats)) {
    Object.entries(subCats).forEach(([subKey, subSubCats]) => {
      // Always add the subcategory
      marqueeTags.push({
        label: subKey.replace(/_/g, ' '),
        url: `/products?category=${encodeURIComponent(catKey)}&subcategory=${encodeURIComponent(subKey)}`
      });

      // If it has sub-subcategories, add those too
      if (typeof subSubCats === 'object' && subSubCats !== null && !Array.isArray(subSubCats)) {
        Object.keys(subSubCats).forEach(subSubKey => {
          marqueeTags.push({
            label: subSubKey.replace(/_/g, ' '),
            url: `/products?category=${encodeURIComponent(catKey)}&subcategory=${encodeURIComponent(subKey)}&subsub=${encodeURIComponent(subSubKey)}`
          });
        });
      }
    });
  }
});

// Thoroughly shuffle the array to ensure completely random assortment
for (let i = marqueeTags.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [marqueeTags[i], marqueeTags[j]] = [marqueeTags[j], marqueeTags[i]];
}

// Pick a good amount to fill three scrolling rows nicely
const selectedTags = marqueeTags.slice(0, 60);
---

<div class="category-marquee-wrapper">
  <div class="tag-scrollers">
    <div class="tag-scroller">
      <ul class="tag-list">
        {selectedTags.slice(0, Math.ceil(selectedTags.length / 3)).map(tag => (
          <li>
            <a href={tag.url}>{tag.label}</a>
          </li>
        ))}
      </ul>
      <ul class="tag-list">
        {selectedTags.slice(Math.ceil(selectedTags.length / 3), Math.ceil(selectedTags.length / 3) * 2).map(tag => (
          <li>
            <a href={tag.url}>{tag.label}</a>
          </li>
        ))}
      </ul>
      <ul class="tag-list">
        {selectedTags.slice(Math.ceil(selectedTags.length / 3) * 2).map(tag => (
          <li>
            <a href={tag.url}>{tag.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .category-marquee-wrapper {
    width: 100%;
    padding: 2rem 0 0 0;
    margin-bottom: -2rem; /* Pulls the next section up closer */
    background: transparent;
    display: grid;
    place-content: center;
    overflow: hidden;
  }

  .tag-scrollers {
    width: 100vw;
    max-width: 100vw;
    overflow: hidden;
  }

  .tag-scroller {
    display: grid;
    gap: 1.2rem;
    padding: 1.5rem 0 1rem 0; /* Gives 1.5rem of empty space at the top so shadows don't clip */
    mask: linear-gradient(90deg, #0000, #000 10%, #000 90%, #0000);
    -webkit-mask: linear-gradient(90deg, #0000, #000 10%, #000 90%, #0000);
  }

  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    gap: 1.5rem;
  }

  @media (prefers-reduced-motion) {
    .tag-list {
      flex-flow: row nowrap;
      overflow: auto;
      scrollbar-width: none;
      scrollbar-color: transparent transparent;
      width: auto;
    }
    .tag-list::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }
  }

  .tag-list li {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1;
    padding: 0;
    white-space: nowrap;
  }

  .tag-list a {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    color: #c5a028;
    background: rgba(197, 160, 40, 0.05);
    border: 1px solid rgba(197, 160, 40, 0.3);
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .tag-list a:hover {
    background: rgba(197, 160, 40, 0.15);
    border-color: #c5a028;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(197, 160, 40, 0.2);
  }

  .tag-scroller.scrolling .tag-list {
    animation: horizontal-scroll var(--duration) var(--direction, normal) linear infinite;
  }

  /* The second row (index 2 in 1-based CSS) scrolls in reverse */
  .tag-scroller.scrolling .tag-list:nth-child(2) {
    --direction: reverse;
  }

  .tag-scroller:hover .tag-list {
    animation-play-state: paused;
  }

  @keyframes horizontal-scroll {
    to {
      transform: translateX(calc(-50% - 0.75rem));
    }
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .category-marquee-wrapper {
      padding: 1rem 0 0 0;
      margin-bottom: -1rem;
    }

    .tag-scroller {
      gap: 0.8rem;
      padding: 1rem 0 0.5rem 0;
      /* Reduce mask strength to keep more chips visible on narrow screens */
      mask: linear-gradient(90deg, #0000, #000 5%, #000 95%, #0000);
      -webkit-mask: linear-gradient(90deg, #0000, #000 5%, #000 95%, #0000);
    }

    .tag-list {
      gap: 0.8rem;
    }

    .tag-list li {
      font-size: 0.85rem;
    }

    .tag-list a {
      padding: 0.5rem 1rem;
    }
    
    @keyframes horizontal-scroll {
      to {
        transform: translateX(calc(-50% - 0.4rem)); /* Adjust for smaller gap */
      }
    }
  }
</style>

<script is:inline>
  function initCategoryMarquee() {
    const mediaQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (mediaQuery && !mediaQuery.matches) {
      const tagScroller = document.querySelector(".tag-scroller");
      if (!tagScroller || tagScroller.classList.contains("scrolling")) return;

      // Add scrolling classes and clone elements for infinite scroll
      tagScroller.classList.add("scrolling");
      
      const tagLists = tagScroller.querySelectorAll(".tag-list");
      tagLists.forEach((tagList) => {
        const scrollContent = Array.from(tagList.children);
        
        // Clone items so it wraps seamlessly
        scrollContent.forEach((listItem) => {
          const clonedItem = listItem.cloneNode(true);
          clonedItem.setAttribute("aria-hidden", true);
          tagList.appendChild(clonedItem);
        });
        
        // Calculate speed based on content width (adjust 50 for faster/slower)
        const duration = (tagList.clientWidth / 50) + "s";
        tagList.style.setProperty("--duration", duration);
      });
    }
  }

  // Initialize immediately
  initCategoryMarquee();

  // Re-initialize on View Transitions
  document.addEventListener('astro:page-load', initCategoryMarquee);
</script>
