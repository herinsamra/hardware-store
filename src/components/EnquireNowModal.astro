---
const { hideButton = false } = Astro.props;
---

<!-- Enquire Now Button -->
{!hideButton && (
<div class="enquire-wrapper">
    <button class="add-to-cart" id="enquireBtn">
        Enquire Now
    </button>
</div>
)}

<!-- Modal Popup -->
<div class="popup-overlay" id="enquireOverlay"></div>
<div class="popup-enquire" id="enquirePopup" role="dialog" aria-modal="true" aria-labelledby="enquireTitle" aria-hidden="true" tabindex="-1">
    <div class="content">
        <div class="content-wrapper">
            <h1 id="enquireTitle">Contact Us</h1>
            <div class="contact-details">
                <a href="https://maps.app.goo.gl/6sXiWvdgFd1Lo9vo6" target="_blank" class="contact-item" style="text-decoration:none; color:inherit;">
                    <span class="icon">📍</span>
                    <div class="info">
                        <strong>Store Address</strong>
                        <span>60/1, Rajakkamangalam Rd, opp. SBI Bank Building,<br/> East Ramanputhoor, Nagercoil 629002</span>
                    </div>
                </a>
                <div class="contact-item">
                    <span class="icon">📞</span>
                    <div class="info">
                        <strong>Call Us</strong>
                        <span><a href="tel:+919488614888" class="phone-link">094886 14888</a> | <a href="tel:+919488624888" class="phone-link">094886 24888</a></span>
                    </div>
                </div>
                <div class="contact-item">
                    <span class="icon">💬</span>
                    <div class="info">
                        <strong>WhatsApp</strong>
                        <span><a href="https://wa.me/919488614888" target="_blank" class="whatsapp-link">+91 94886 14888</a></span>
                    </div>
                </div>
            </div>
            
            <a href="/contact" class="try-again">View More</a>
            <button type="button" class="close-btn" id="closeEnquireBtn">Close</button>
        </div>
    </div>
</div>

<script is:inline>
    const enquireBtn = document.getElementById('enquireBtn');
    const closeBtn = document.getElementById('closeEnquireBtn');
    const overlay = document.getElementById('enquireOverlay');
    const popup = document.getElementById('enquirePopup');

    if (overlay && overlay.parentElement !== document.body) {
        document.body.appendChild(overlay);
    }

    if (popup && popup.parentElement !== document.body) {
        document.body.appendChild(popup);
    }

    const openEnquireModal = () => {
        document.body.classList.add('enquire-active');
        popup?.setAttribute('aria-hidden', 'false');
        requestAnimationFrame(() => popup?.focus());

        if (typeof gtag === 'function') {
            gtag('event', 'enquiry_open', {
                'event_category': 'Engagement',
                'event_label': 'Enquire Now Modal Opened'
            });
        }
    };

    const closeEnquireModal = () => {
        document.body.classList.remove('enquire-active');
        popup?.setAttribute('aria-hidden', 'true');
        enquireBtn?.focus();
    };

    if (enquireBtn) {
        enquireBtn.addEventListener('click', openEnquireModal);
    }

    if (closeBtn) {
        closeBtn.addEventListener('click', closeEnquireModal);
    }
    
    if (overlay) {
        overlay.addEventListener('click', closeEnquireModal);
    }

    // Global delegation for dynamically added trigger elements
    document.addEventListener('click', (event) => {
        const trigger = event.target.closest('.enquire-trigger');
        if (trigger) {
            event.preventDefault();
            openEnquireModal();
        }
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && document.body.classList.contains('enquire-active')) {
            closeEnquireModal();
        }
    });

    // Track Contact Link Clicks
    document.querySelectorAll('.contact-item, .phone-link, .whatsapp-link').forEach(link => {
        link.addEventListener('click', (e) => {
            const target = e.currentTarget;
            let label = 'Unknown Contact Link';
            
            if (target.classList.contains('phone-link')) label = 'Phone Call';
            else if (target.classList.contains('whatsapp-link')) label = 'WhatsApp Chat';
            else if (target.tagName === 'A' && target.href.includes('maps.app.goo.gl')) label = 'Google Maps Directions';

            if (typeof gtag === 'function') {
                gtag('event', 'contact_click', {
                    'event_category': 'Engagement',
                    'event_label': label,
                    'value': 1
                });
            }
        });
    });
</script>

<style>
/* Button Styles */
.enquire-wrapper {
    display: inline-block;
    position: relative;
    margin-top: 1rem;
}

.add-to-cart {
    width: fit-content;
    background: linear-gradient(145deg, #ddb644, #a58115);
    color: #0a0c10;
    border: none;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    font-family: inherit;
    font-size: 1rem;
    cursor: pointer;
    box-shadow:
      10px 10px 22px rgba(7, 10, 17, 0.38),
      -8px -8px 18px rgba(255, 231, 160, 0.14);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      filter 0.2s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
}

.add-to-cart:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
    box-shadow:
      14px 14px 26px rgba(7, 10, 17, 0.42),
      -10px -10px 20px rgba(255, 231, 160, 0.18);
}


/* Modal Styles */
.popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(7, 10, 17, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.4s ease, visibility 0.4s ease;
}

.popup-enquire {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -45%) scale(0.94);
    width: min(26rem, calc(100vw - 2rem));
    max-width: calc(100vw - 2rem);
    z-index: 1000;
    border-radius: 24px;
    background: linear-gradient(145deg, rgba(22, 30, 46, 0.98), rgba(15, 20, 31, 1));
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 
        0 20px 50px rgba(0, 0, 0, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); /* Sleek modern ease out */
    overflow: hidden;
    box-sizing: border-box;
}

/* Subtle glowing aura behind the content */
.popup-enquire::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(197, 160, 40, 0.08) 0%, transparent 60%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.7s ease 0.2s;
}

.content {
    position: relative;
    z-index: 10;
    width: 100%;
    padding: 2rem 1.4rem 1.35rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
}

/* Staggered Entrance Elements */
.content-wrapper > * {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.content-wrapper {
    width: 100%;
    text-align: center;
    color: var(--text-primary);
    box-sizing: border-box;
}

.content-wrapper h1 {
    margin: 0 0 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 1.75rem;
    color: var(--accent-gold);
    font-weight: 800;
    line-height: 1.05;
}

.contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    text-align: left;
}

.contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    background: rgba(255, 255, 255, 0.045);
    padding: 0.95rem 1rem;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    box-sizing: border-box;
    min-width: 0;
}

.contact-item:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
    border-color: rgba(197, 160, 40, 0.2);
}

.contact-item .icon {
    font-size: 1.35rem;
    background: rgba(197, 160, 40, 0.1);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    flex-shrink: 0;
    box-shadow: inset 0 0 15px rgba(197, 160, 40, 0.15);
}

.contact-item .info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
}

.contact-item .info strong {
    color: var(--accent-gold);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
}

.contact-item .info span {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.45;
    word-break: break-word;
}

.phone-link, .whatsapp-link {
    color: var(--accent-gold-light);
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition: color 0.2s ease;
}

.phone-link:hover, .whatsapp-link:hover {
    color: var(--accent-gold);
}

.try-again {
    cursor: pointer;
    position: relative;
    font-size: 0.95rem;
    color: var(--text-primary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--accent-gold);
    border-radius: 999px;
    transition: all 0.3s ease;
    background: rgba(197, 160, 40, 0.1);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
}

.try-again:hover {
    background: var(--accent-gold);
    color: #000;
    box-shadow: 0 0 20px rgba(197, 160, 40, 0.4);
}

.close-btn {
    cursor: pointer;
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-top: 0;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    transition: color 0.2s ease;
    background: transparent;
    border: none;
    padding: 0;
    font-family: inherit;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
}

.content-wrapper > .try-again,
.content-wrapper > .close-btn {
    margin-top: 0.2rem;
}

.content-wrapper > .try-again + .close-btn {
    margin-left: 0.9rem;
}

.content-wrapper > .try-again,
.content-wrapper > .close-btn {
    vertical-align: middle;
}

@media (max-width: 640px) {
    .popup-enquire {
        width: min(23rem, calc(100vw - 1.2rem));
        border-radius: 22px;
    }

    .content {
        padding: 1.5rem 1rem 1.1rem;
    }

    .content-wrapper h1 {
        font-size: 1.45rem;
        margin-bottom: 1rem;
    }

    .contact-details {
        gap: 0.65rem;
        margin-bottom: 1rem;
    }

    .contact-item {
        padding: 0.85rem 0.9rem;
        gap: 0.75rem;
        border-radius: 16px;
    }

    .contact-item .icon {
        width: 40px;
        height: 40px;
        font-size: 1.15rem;
    }

    .contact-item .info strong {
        font-size: 0.75rem;
    }

    .contact-item .info span,
    .phone-link,
    .whatsapp-link {
        font-size: 0.92rem;
    }

    .try-again {
        padding: 0.75rem 1.15rem;
        font-size: 0.88rem;
    }

    .close-btn {
        font-size: 0.76rem;
    }
}

.close-btn:hover {
    color: var(--text-primary);
}

/* Global Activation Classes */
body.enquire-active {
    overflow: hidden; 
}

body.enquire-active .popup-overlay {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

body.enquire-active .popup-enquire {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, -50%) scale(1);
    border-color: rgba(197, 160, 40, 0.2);
    box-shadow: 
        0 30px 60px rgba(0, 0, 0, 0.7),
        inset 0 1px 0 rgba(255, 255, 255, 0.1),
        0 0 40px rgba(197, 160, 40, 0.1);
}

body.enquire-active .popup-enquire::before {
    opacity: 1;
}

/* Trigger Staggered Animations */
body.enquire-active .content-wrapper > h1 { 
    opacity: 1; 
    transform: translateY(0);
    transition-delay: 0.15s; 
}
body.enquire-active .content-wrapper > .contact-details { 
    opacity: 1; 
    transform: translateY(0);
    transition-delay: 0.25s; 
}
body.enquire-active .content-wrapper > .try-again { 
    opacity: 1; 
    transform: translateY(0);
    transition-delay: 0.35s; 
}
body.enquire-active .content-wrapper > .close-btn { 
    opacity: 1; 
    transform: translateY(0);
    transition-delay: 0.45s; 
}
</style>
