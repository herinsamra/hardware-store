<!-- Enquire Now Button -->
<div class="enquire-wrapper">
    <button class="add-to-cart" id="enquireBtn">
        Enquire Now
    </button>
</div>

<!-- Modal Popup -->
<div class="popup-overlay" id="enquireOverlay"></div>
<div class="popup-enquire" id="enquirePopup">
    <div class="content">
        <div class="content-wrapper">
            <h1>Contact Us</h1>
            <div class="contact-details">
                <div class="contact-item">
                    <span class="icon">📍</span>
                    <div class="info">
                        <strong>Store Address</strong>
                        <span>60/1, Rajakkamangalam Rd, opp. SBI Bank Building,<br/> East Ramanputhoor, Nagercoil 629002</span>
                    </div>
                </div>
                <div class="contact-item">
                    <span class="icon">📞</span>
                    <div class="info">
                        <strong>Call Us</strong>
                        <span><a href="tel:+919488614888" class="phone-link">094886 14888</a> | <a href="tel:+919488624888" class="phone-link">094886 24888</a></span>
                    </div>
                </div>
                <div class="contact-item">
                    <span class="icon">💬</span>
                    <div class="info">
                        <strong>WhatsApp</strong>
                        <span><a href="https://wa.me/919488614888" target="_blank" class="whatsapp-link">+91 94886 14888</a></span>
                    </div>
                </div>
            </div>
            
            <a href="/contact" class="try-again">View More</a>
            <p class="close-btn" id="closeEnquireBtn">Close</p>
        </div>
    </div>
</div>

<script>
    const enquireBtn = document.getElementById('enquireBtn');
    const closeBtn = document.getElementById('closeEnquireBtn');
    const overlay = document.getElementById('enquireOverlay');

    if (enquireBtn) {
        enquireBtn.addEventListener('click', () => {
            document.body.classList.add('enquire-active');
        });
    }

    if (closeBtn) {
        closeBtn.addEventListener('click', () => {
            document.body.classList.remove('enquire-active');
        });
    }
    
    if (overlay) {
        overlay.addEventListener('click', () => {
            document.body.classList.remove('enquire-active');
        });
    }
</script>

<style>
/* Button Styles */
.enquire-wrapper {
    display: inline-block;
    position: relative;
    margin-top: 1rem;
}

.add-to-cart {
    width: fit-content;
    background: linear-gradient(145deg, #ddb644, #a58115);
    color: #0a0c10;
    border: none;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    font-family: inherit;
    font-size: 1rem;
    cursor: pointer;
    box-shadow:
      10px 10px 22px rgba(7, 10, 17, 0.38),
      -8px -8px 18px rgba(255, 231, 160, 0.14);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      filter 0.2s ease;
}

.add-to-cart:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
    box-shadow:
      14px 14px 26px rgba(7, 10, 17, 0.42),
      -10px -10px 20px rgba(255, 231, 160, 0.18);
}


/* Modal Styles */
.popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(7, 10, 17, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
}

.popup-enquire {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -45%) scale(0.94);
    width: 90vw;
    max-width: 480px;
    height: auto;
    z-index: 1000;
    border-radius: 24px;
    background: linear-gradient(145deg, rgba(22, 30, 46, 0.98), rgba(15, 20, 31, 1));
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 
        0 20px 50px rgba(0, 0, 0, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    opacity: 0;
    visibility: hidden;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1); /* Sleek modern ease out */
    overflow: hidden;
}

/* Subtle glowing aura behind the content */
.popup-enquire::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(197, 160, 40, 0.08) 0%, transparent 60%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.7s ease 0.2s;
}

.content {
    position: relative;
    z-index: 10;
    width: 100%;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* Staggered Entrance Elements */
.content-wrapper > * {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.content-wrapper {
    width: 100%;
    text-align: center;
    color: var(--text-primary);
}

.content-wrapper h1 {
    padding-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 22px;
    color: var(--accent-gold);
    font-weight: 800;
}

.contact-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 25px;
    text-align: left;
}

.contact-item {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255, 255, 255, 0.03);
    padding: 1.2rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
}

.contact-item:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
    border-color: rgba(197, 160, 40, 0.2);
}

.contact-item .icon {
    font-size: 1.6rem;
    background: rgba(197, 160, 40, 0.1);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    flex-shrink: 0;
    box-shadow: inset 0 0 15px rgba(197, 160, 40, 0.15);
}

.contact-item .info {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.contact-item .info strong {
    color: var(--accent-gold);
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 700;
}

.contact-item .info span {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.4;
}

.phone-link, .whatsapp-link {
    color: var(--accent-gold-light);
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition: color 0.2s ease;
}

.phone-link:hover, .whatsapp-link:hover {
    color: var(--accent-gold);
}

.try-again {
    cursor: pointer;
    position: relative;
    font-size: 15px;
    color: var(--text-primary);
    text-decoration: none;
    display: inline-block;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0.8rem 1.5rem;
    border: 1px solid var(--accent-gold);
    border-radius: 999px;
    transition: all 0.3s ease;
    background: rgba(197, 160, 40, 0.1);
}

.try-again:hover {
    background: var(--accent-gold);
    color: #000;
    box-shadow: 0 0 20px rgba(197, 160, 40, 0.4);
}

.close-btn {
    cursor: pointer;
    font-size: 13px;
    color: var(--text-secondary);
    margin-top: 25px;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: color 0.2s ease;
}

.close-btn:hover {
    color: var(--text-primary);
}

/* Global Activation Classes */
body.enquire-active {
    overflow: hidden; 
}

body.enquire-active .popup-overlay {
    opacity: 1;
    visibility: visible;
}

body.enquire-active .popup-enquire {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
    border-color: rgba(197, 160, 40, 0.2);
    box-shadow: 
        0 30px 60px rgba(0, 0, 0, 0.7),
        inset 0 1px 0 rgba(255, 255, 255, 0.1),
        0 0 40px rgba(197, 160, 40, 0.1);
}

body.enquire-active .popup-enquire::before {
    opacity: 1;
}

/* Trigger Staggered Animations */
body.enquire-active .content-wrapper > h1 { 
    opacity: 1; 
    transform: translateY(0);
    transition-delay: 0.15s; 
}
body.enquire-active .content-wrapper > .contact-details { 
    opacity: 1; 
    transform: translateY(0);
    transition-delay: 0.25s; 
}
body.enquire-active .content-wrapper > .try-again { 
    opacity: 1; 
    transform: translateY(0);
    transition-delay: 0.35s; 
}
body.enquire-active .content-wrapper > .close-btn { 
    opacity: 1; 
    transform: translateY(0);
    transition-delay: 0.45s; 
}
</style>
