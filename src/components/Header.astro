---
interface Props {
  useOldNav?: boolean;
}
const { useOldNav = false } = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'HOME' },
  { href: '/categories', label: 'CATEGORIES' },
  { href: '/products', label: 'PRODUCTS' },
  { href: '/contact', label: 'CONTACT' },
];

const isHome = currentPath === '/';
const showSearch = currentPath.startsWith('/products') || currentPath.startsWith('/categories');
---

<header class="site-header" data-site-header role="banner">
  <div class:list={['site-header-spacer', { 'home-spacer': isHome }]} aria-hidden="true"></div>

  <nav class="navbar glass-strong" aria-label="Primary">
    <div class="navbar-content">
      <!-- Logo + brand name (centered) -->
      <div class="logo-center">
        <a href="/" class="logo-link" data-astro-prefetch="hover">
          <img 
            src="https://res.cloudinary.com/dthi2vgiz/image/upload/v1778068012/new_logo_ppmggi.png" 
            alt="Peniel Hardwares Logo"
            class="logo-img"
          />
          <span class="logo-text">Peniel Hardwares</span>
        </a>
      </div>
      <!-- Desktop Nav links (hidden on mobile) -->
      <div class="nav-links desktop-nav">
        {navLinks.map(link => (
          <a 
            href={link.href} 
            data-astro-prefetch="hover"
            class:list={[
              'nav-link',
              { active: link.href === '/' ? currentPath === '/' : currentPath === link.href || currentPath.startsWith(link.href + '/') }
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Header Search -->
      {showSearch && (
        <form action="/products" method="get" class="header-search">
          <input type="text" name="search" placeholder="Search products..." class="header-search-input" aria-label="Search products" autocomplete="off" />
          <button type="submit" class="header-search-btn" aria-label="Submit search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
        </form>
      )}
    </div>
  </nav>

  {useOldNav && (
    <>
      <!-- Mobile Hamburger Menu (visible only on mobile) -->
      <input class="mobile-menu-icon" type="checkbox" id="mobile-menu-icon" name="mobile-menu-icon"/>
      <label for="mobile-menu-icon" class="mobile-menu-label" aria-label="Toggle menu"></label>
      <div class="mobile-nav">
        <ul>
          {navLinks.map(link => (
            <li>
              <a 
                href={link.href}
                data-astro-prefetch="hover"
                class:list={[
                  { 'mobile-active': link.href === '/' ? currentPath === '/' : currentPath === link.href || currentPath.startsWith(link.href + '/') }
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </>
  )}
</header>

<!-- Desktop styles (scoped is fine) -->
<style>
  .site-header {
    --header-height-expanded: 8.25rem;
    --header-height-compact: 6.65rem;
    position: relative;
    z-index: 50;
  }
  .site-header-spacer {
    height: var(--header-height-expanded);
  }
  .site-header-spacer.home-spacer {
    height: 3.8rem; /* Adjust this value to fine-tune the gap */
  }
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transform: translateY(0);
    transition:
      transform 0.36s cubic-bezier(0.215, 0.61, 0.355, 1),
      background-color 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
    will-change: transform;
  }
  .site-header.is-hidden .navbar {
    transform: translateY(calc(-100% - 0.75rem));
  }
  .navbar.is-scrolled {
    transform: translateY(0) scale(0.98);
    border-radius: 1.5rem;
    top: 0.5rem;
    left: 1rem;
    right: 1rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
    background-color: rgba(15, 23, 42, 0.85);
  }
  .site-header.is-hidden .navbar.is-scrolled {
    transform: translateY(calc(-100% - 2rem)) scale(0.98);
  }
  .navbar-content {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    transition: padding 0.3s ease;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  @media (max-width: 768px) {
    .navbar-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
    }
  }
  .site-header .navbar-content {
    padding-top: 0.65rem;
    padding-bottom: 0.75rem;
  }
  .logo-center {
    justify-self: center;
    text-align: center;
    margin-bottom: 0.75rem;
    transition: margin-bottom 0.3s ease;
  }
  @media (max-width: 768px) {
    .logo-center {
      justify-self: center;
      margin-bottom: 0;
    }
  }
  .site-header .logo-center {
    margin-bottom: 0;
  }
  .logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .logo-link:hover {
    opacity: 0.9;
  }
  .logo-img {
    height: 2.5rem;
    width: auto;
    transition: height 0.3s ease;
    animation: subtleGlow 3s infinite alternate;
  }
  @keyframes subtleGlow {
    0% {
      -webkit-filter: drop-shadow(0 0 10px rgba(172, 148, 34, 0.9)) drop-shadow(0 0 2px rgba(172, 148, 34, 1));
      filter: drop-shadow(0 0 10px rgba(172, 148, 34, 0.9)) drop-shadow(0 0 2px rgba(172, 148, 34, 1));
    }
    100% {
      -webkit-filter: drop-shadow(0 0 25px rgba(227, 193, 24, 1)) drop-shadow(0 0 8px rgba(227, 193, 24, 1));
      filter: drop-shadow(0 0 25px rgba(227, 193, 24, 1)) drop-shadow(0 0 8px rgba(227, 193, 24, 1));
    }
  }
  .site-header .logo-img {
    height: 2.15rem;
  }
  .logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    background: linear-gradient(135deg, #ffffff, var(--accent-gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: font-size 0.3s ease;
  }
  .site-header .logo-text {
    font-size: 1.35rem;
  }
  .nav-links {
    display: flex;
    justify-content: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
    transition: gap 0.3s ease, padding-top 0.3s ease;
  }
  .site-header .nav-links {
    gap: 1.5rem;
  }
  .header-search {
    justify-self: end;
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
    max-width: 280px;
  }
  @media (max-width: 768px) {
    .header-search {
      max-width: 90%;
      margin: 0 auto;
      justify-self: center;
    }
  }
  .header-search-input {
    width: 100%;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2rem;
    padding: 0.55rem 1rem 0.55rem 2.5rem;
    color: var(--text-primary);
    font-size: 0.85rem;
    transition: all 0.3s ease;
  }
  .header-search-input:focus {
    outline: none;
    border-color: var(--accent-gold);
    background: rgba(15, 23, 42, 0.8);
    box-shadow: 0 0 0 2px rgba(197, 160, 40, 0.2);
  }
  .header-search-btn {
    position: absolute;
    left: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--text-secondary);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.3s ease;
  }
  .header-search-input:focus + .header-search-btn,
  .header-search-btn:hover {
    color: var(--accent-gold);
  }
  .search-icon {
    width: 16px;
    height: 16px;
  }
  .nav-link {
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 600;
    transition: color 0.3s;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--accent-gold);
  }
  .nav-link.active::after {
    content: '';
    display: block;
    width: 100%;
    height: 2px;
    background: var(--accent-gold);
    margin-top: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .navbar-content,
    .logo-center,
    .logo-img,
    .logo-text,
    .nav-links {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    /* Hide desktop nav links on mobile */
    .desktop-nav {
      display: none !important;
    }
    /* Increase spacer since we have two lines now */
    .site-header {
      --header-height-expanded: 7.5rem;
      --header-height-compact: 7rem;
    }
    .site-header .logo-center {
      margin-bottom: 0;
    }
    .logo-img { height: 2.25rem; }
    .logo-text { font-size: 1.4rem; }
    .site-header .logo-img { height: 2.1rem; }
    .site-header .logo-text { font-size: 1.3rem; }
  }
</style>

{useOldNav && (
<style is:global>
  /* ==============================
     MOBILE MENU — Animated Blob
     ============================== */

  /* Hidden on desktop by default */
  .mobile-menu-icon,
  .mobile-menu-label,
  .mobile-nav {
    display: none !important;
  }

  @media (max-width: 768px) {
    /* Checkbox hack — hide input offscreen */
    .mobile-menu-icon {
      display: block !important;
      position: absolute !important;
      left: -9999px !important;
    }

    /* Hamburger icon (label) */
    .mobile-menu-label {
      display: block !important;
      position: fixed !important;
      top: 22px;
      right: 30px;
      width: 30px;
      height: 30px;
      padding: 0;
      margin: 0;
      cursor: pointer;
      z-index: 110;
    }
    .mobile-menu-label:before,
    .mobile-menu-label:after {
      position: absolute;
      content: '';
      display: block;
    }
    /* Top & bottom bars */
    .mobile-menu-label:before {
      width: 30px;
      height: 20px;
      top: 0;
      left: 0;
      border-top: 2px solid #ececee;
      border-bottom: 2px solid #ececee;
      transition: border-width 100ms 1500ms ease, 
                  top 100ms 1600ms cubic-bezier(0.23, 1, 0.32, 1),
                  height 100ms 1600ms cubic-bezier(0.23, 1, 0.32, 1), 
                  background-color 200ms ease,
                  transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    /* Middle bar */
    .mobile-menu-label:after {
      width: 22px;
      height: 2px;
      top: 10px;
      right: 4px;
      background-color: #ececee;
      margin-top: -1px;
      transition: width 100ms 1750ms ease, 
                  right 100ms 1750ms ease,
                  margin-top 100ms ease, 
                  transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    /* Checked state — X morph */
    .mobile-menu-icon:checked + .mobile-menu-label:before {
      top: 10px;
      transform: rotate(45deg);
      height: 2px;
      background-color: #ececee;
      border-width: 0;
      transition: border-width 100ms 340ms ease, 
                  top 100ms 300ms cubic-bezier(0.23, 1, 0.32, 1),
                  height 100ms 300ms cubic-bezier(0.23, 1, 0.32, 1), 
                  background-color 200ms 500ms ease,
                  transform 200ms 1700ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .mobile-menu-icon:checked + .mobile-menu-label:after {
      width: 30px;
      margin-top: 0;
      right: 0;
      transform: rotate(-45deg);
      transition: width 100ms ease,
                  right 100ms ease,  
                  margin-top 100ms 500ms ease, 
                  transform 200ms 1700ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    /* Blob Nav Container */
    .mobile-nav {
      display: block !important;
      position: fixed !important;
      top: 10px;
      right: 10px;
      width: 70px;
      height: 70px;
      padding: 0;
      margin: 0;
      z-index: 100;
      overflow: hidden;
      box-shadow: 0 8px 30px 0 rgba(0, 0, 0, 0.4);
      background-color: var(--bg-secondary, #1e293b);
      animation: mobile-border-transform 7s linear infinite;
      transition: top 350ms 1100ms cubic-bezier(0.23, 1, 0.32, 1),  
                  right 350ms 1100ms cubic-bezier(0.23, 1, 0.32, 1),
                  transform 250ms 1100ms ease,
                  width 650ms 400ms cubic-bezier(0.23, 1, 0.32, 1),
                  height 650ms 400ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    @keyframes mobile-border-transform {
      0%,100% { border-radius: 63% 37% 54% 46% / 55% 48% 52% 45%; } 
      14%     { border-radius: 40% 60% 54% 46% / 49% 60% 40% 51%; } 
      28%     { border-radius: 54% 46% 38% 62% / 49% 70% 30% 51%; } 
      42%     { border-radius: 61% 39% 55% 45% / 61% 38% 62% 39%; } 
      56%     { border-radius: 61% 39% 67% 33% / 70% 50% 50% 30%; } 
      70%     { border-radius: 50% 50% 34% 66% / 56% 68% 32% 44%; } 
      84%     { border-radius: 46% 54% 50% 50% / 35% 61% 39% 65%; } 
    }

    /* Expanded state — fullscreen takeover */
    .mobile-menu-icon:checked ~ .mobile-nav {
      animation-play-state: paused;
      top: 50%;
      right: 50%;
      transform: translate(50%, -50%);
      width: 200vw;
      height: 200vh;
      transition: top 350ms 700ms cubic-bezier(0.23, 1, 0.32, 1),  
                  right 350ms 700ms cubic-bezier(0.23, 1, 0.32, 1),
                  transform 250ms 700ms ease,
                  width 750ms 1000ms cubic-bezier(0.23, 1, 0.32, 1),
                  height 750ms 1000ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    /* Nav Links List */
    .mobile-nav ul {
      position: absolute;
      top: 50%;
      left: 0;
      display: block;
      width: 100%;
      padding: 0;
      margin: 0;
      z-index: 6;
      text-align: center;
      transform: translateY(-50%);
      list-style: none;
    }
    .mobile-nav ul li {
      position: relative;
      display: block;
      width: 100%;
      padding: 0;
      margin: 10px 0;
      text-align: center;
      list-style: none;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transform: translateY(30px);
      transition: all 250ms linear;
    }
    .mobile-nav ul li:nth-child(1) { transition-delay: 200ms; }
    .mobile-nav ul li:nth-child(2) { transition-delay: 150ms; }
    .mobile-nav ul li:nth-child(3) { transition-delay: 100ms; }
    .mobile-nav ul li:nth-child(4) { transition-delay: 50ms; }

    .mobile-nav ul li a {
      font-family: 'Inter', sans-serif;
      font-size: 5vh;
      text-transform: uppercase;
      line-height: 1.2;
      font-weight: 800;
      display: inline-block;
      position: relative;
      color: #ececee;
      text-decoration: none;
      transition: all 250ms linear;
    }
    .mobile-nav ul li a:hover,
    .mobile-nav ul li a.mobile-active {
      color: var(--accent-gold, #c5a028);
    }
    .mobile-nav ul li a:after {
      display: block;
      position: absolute;
      top: 50%;
      content: '';
      height: 2vh;
      margin-top: -1vh;
      width: 0;
      left: 0;
      background-color: var(--bg-secondary, #1e293b);
      opacity: 0.8;
      transition: width 250ms linear;
    }
    .mobile-nav ul li a:hover:after {
      width: 100%;
    }

    /* Expand nav links when menu is checked */
    .mobile-menu-icon:checked ~ .mobile-nav ul li {
      pointer-events: auto;
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
      transition: opacity 350ms ease,
                  transform 250ms ease;
    }
    .mobile-menu-icon:checked ~ .mobile-nav ul li:nth-child(1) { transition-delay: 1400ms; }
    .mobile-menu-icon:checked ~ .mobile-nav ul li:nth-child(2) { transition-delay: 1480ms; }
    .mobile-menu-icon:checked ~ .mobile-nav ul li:nth-child(3) { transition-delay: 1560ms; }
    .mobile-menu-icon:checked ~ .mobile-nav ul li:nth-child(4) { transition-delay: 1640ms; }
  }

  @media (max-width: 400px) {
    .mobile-nav ul li a {
      font-size: 4vh;
    }
  }
</style>
)}



<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    if (!(header instanceof HTMLElement)) return;

    let ticking = false;
    
    // Default to window scroll
    const scrollContainer = document.getElementById('main-scroll-container');
    
    // In shazam layout, the inner container only scrolls when the menu is OPEN.
    // However, for normal browsing/animation, we should generally track window scroll
    // UNLESS the body is locked.
    const getTarget = () => {
      if (document.body.classList.contains('shazam-open') && scrollContainer) {
        return scrollContainer;
      }
      return window;
    };
    
    let target = getTarget();

    let lastScrollY = target === window ? window.pageYOffset : (target.scrollTop || 0);

    const updateHeader = () => {
      target = getTarget();
      const currentScrollY = target === window ? window.pageYOffset : (target.scrollTop || 0);
      const delta = currentScrollY - lastScrollY;

      // Always remove hidden when at the very top
      if (currentScrollY <= 10) {
        header.classList.remove('is-hidden');
        header.querySelector('.navbar').classList.remove('is-scrolled');
        lastScrollY = currentScrollY;
        ticking = false;
        return;
      }

      // Add inwards scale when scrolled
      if (currentScrollY > 50) {
        header.querySelector('.navbar').classList.add('is-scrolled');
      }

      // Scrolling down → hide
      if (delta > 5 && currentScrollY > 100) {
        header.classList.add('is-hidden');
      } 
      // Scrolling up → show
      else if (delta < -5) {
        header.classList.remove('is-hidden');
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    target.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateHeader);
    }, { passive: true });

    // Re-evaluate target on resize
    window.addEventListener('resize', () => {
      const newTarget = scrollContainer && window.innerWidth <= 768 ? scrollContainer : window;
      if (newTarget !== target) {
        target.removeEventListener('scroll', updateHeader);
        target = newTarget;
        lastScrollY = target === window ? window.scrollY : target.scrollTop;
        target.addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(updateHeader);
        }, { passive: true });
      }
    });

    updateHeader();

    // Close mobile menu when a link is clicked
    const mobileCheckbox = document.getElementById('mobile-menu-icon');
    const mobileLinks = document.querySelectorAll('.mobile-nav a');
    if (mobileCheckbox && mobileLinks.length) {
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileCheckbox.checked = false;
        });
      });
    }
  })();
</script>
