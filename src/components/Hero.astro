---
const heroTexts = [
  { 
    title: "Complete Solutions for Modern Living.", 
    subtitle: "One Store. Every Essential." 
  },
  { 
    title: "Building Solutions. Trusted Brands.", 
    subtitle: "Everything for Your Dream Build" 
  },
  { 
    title: "Inspired by Luxury. Built on Quality.", 
    subtitle: "Premium Living, Perfected" 
  },
  { 
    title: "Crafting Excellence in Every Detail.", 
    subtitle: "Quality Products. Better Prices." 
  },
  { 
    title: "Sophisticated Solutions for Every Space", 
    subtitle: "Luxury • Quality • Trust" 
  },
  { 
    title: "Everything You Need to Build & Upgrade", 
    subtitle: "Luxury Within Reach ✨" 
  }
];

// Simple randomizer for static builds - will stick to one per build, 
// or we can use a small script for client-side random.
// For Astro, we can pick one during build. 
// But if they want it "each tym the site is visited", we need client-side JS or SSR.
// I will provide client-side JS for true per-visit randomization.

const {
  ctaText = "Contact Us",
  ctaLink = "/contact",
  videoUrl = "https://res.cloudinary.com/dthi2vgiz/video/upload/v1775646510/InShot_20260408_163545367_qjnldx.mp4"
} = Astro.props;
---

<section class="hero">
  <video 
    class="hero-video"
    autoplay 
    muted 
    loop 
    playsinline
    poster="https://res.cloudinary.com/dthi2vgiz/image/upload/v1777986032/Screenshot_2026-05-05_182941_yp4oq8.png"
  >
    <source src={videoUrl} type="video/mp4" />
  </video>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1 id="hero-title" class="opacity-0 translate-y-4 transition-all duration-700">Building Solutions. Trusted Brands.</h1>
    <p id="hero-subtitle" class="opacity-0 translate-y-4 transition-all duration-700 delay-150">Everything for Your Dream Build</p>
    <a href={ctaLink} class="hero-button opacity-0 translate-y-4 transition-all duration-700 delay-300" data-astro-prefetch="hover">
      {ctaText}
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>

  <script is:inline define:vars={{ heroTexts }}>
    document.addEventListener('DOMContentLoaded', () => {
      const titleEl = document.getElementById('hero-title');
      const subtitleEl = document.getElementById('hero-subtitle');
      const btnEl = document.querySelector('.hero-button');
      
      // Randomly pick a set
      const selected = heroTexts[Math.floor(Math.random() * heroTexts.length)];
      
      if (titleEl && subtitleEl) {
        titleEl.textContent = selected.title;
        subtitleEl.textContent = selected.subtitle;
        
        // Trigger animations
        requestAnimationFrame(() => {
          titleEl.classList.remove('opacity-0', 'translate-y-4');
          subtitleEl.classList.remove('opacity-0', 'translate-y-4');
          btnEl?.classList.remove('opacity-0', 'translate-y-4');
        });
      }
    });
  </script>
</section>

<style>
  .hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    margin-top: -1.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }
  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    color: white;
    padding: 0 1rem;
  }
  .hero-content h1 {
    font-size: clamp(2.2rem, 6vw, 3.8rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
    line-height: 1.15;
    text-transform: none;
    letter-spacing: -0.01em;
    background: linear-gradient(135deg, 
      #ffffff 0%, 
      #cbd5e1 25%, 
      #ffffff 50%, 
      #94a3b8 75%, 
      #e2e8f0 100%
    );
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.4));
    text-shadow: none;
    display: inline-block; /* Helps with background clipping on some browsers */
  }
  .hero-content p {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--accent-gold);
    margin-bottom: 2.5rem;
    max-width: 45rem;
    margin-left: auto;
    margin-right: auto;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }
  .hero-button {
    background: var(--accent-gold);
    color: #0f172a;
    font-weight: bold;
    padding: 0.75rem 2rem;
    border-radius: 0.5rem;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  .hero-button:hover {
    background: var(--accent-gold-light);
    transform: scale(1.02);
  }
  @media (min-width: 640px) {
    .hero-content h1 { font-size: 3.5rem; }
  }
  @media (min-width: 768px) {
    .hero-content h1 { font-size: 4rem; }
  }
  @media (max-width: 640px) {
    .hero {
      margin-top: -1rem;
    }
  }
</style>
