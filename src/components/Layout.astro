---
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../styles/global.css';
import { generateOrganizationSchema, generateBreadcrumbSchema } from '../lib/seo.js';

interface Props {
  title?: string;
  description?: string;
  isHomePage?: boolean;
  canonical?: string;
  image?: string;
  openGraphType?: string;
  showFooter?: boolean;
  useOldNav?: boolean;
  breadcrumbs?: Array<{name: string, url?: string}>; // For breadcrumb schema
  hideOrgSchema?: boolean; // New prop to prevent redundant schemas
}

const { 
  title = 'Peniel Hardware - Quality Materials',
  description = 'Your one-stop shop for quality hardware, tools, plumbing, electrical, and building materials.',
  isHomePage = false,
  canonical,
  image,
  openGraphType = 'website',
  showFooter = true,
  useOldNav = false,
  breadcrumbs,
  hideOrgSchema = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'HOME', icon: 'fa-home' },
  { href: '/categories', label: 'CATEGORIES', icon: 'fa-list' },
  { href: '/products', label: 'PRODUCTS', icon: 'fa-box' },
  { href: '/contact', label: 'CONTACT', icon: 'fa-envelope' },
];

function resolveMetaUrl(value?: string): string | undefined {
  if (!value) return undefined;
  if (/^https?:\/\//i.test(value)) return value;
  if (Astro.site) return new URL(value, Astro.site).toString();
  return value;
}

const canonicalUrl = resolveMetaUrl(canonical || Astro.url.pathname);
const socialImage = resolveMetaUrl(image);
const absoluteCanonicalUrl = canonicalUrl && /^https?:\/\//i.test(canonicalUrl) ? canonicalUrl : undefined;

// Generate organization schema
const orgSchema = generateOrganizationSchema(Astro.site?.toString());

// Generate breadcrumb schema if breadcrumbs are provided
const breadcrumbSchema = breadcrumbs ? 
  generateBreadcrumbSchema(breadcrumbs, Astro.site?.toString()) : null;
---

<!DOCTYPE html>
<html lang="en" class:list={[{ 'shazam-layout': !useOldNav }]}>
<head>
  <meta name="google-site-verification" content="HKbfLqqj201jh2AghDmk4d761QVKyD_6gmK5-2E-XJ0" />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-P8VWMQW9C8"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-P8VWMQW9C8');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="robots" content="index,follow">
  <meta name="theme-color" content="#1a472a">
  <link rel="icon" type="image/x-icon" href="https://res.cloudinary.com/dthi2vgiz/image/upload/v1778067898/favicon_zncfgk.ico">
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={openGraphType} />
  {absoluteCanonicalUrl && <meta property="og:url" content={absoluteCanonicalUrl} />}
  {socialImage && <meta property="og:image" content={socialImage} />}
  <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {socialImage && <meta name="twitter:image" content={socialImage} />}
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  {/* Organization Schema */}
  {!hideOrgSchema && <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />}
  
  {/* Breadcrumb Schema if provided */}
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
</head>
<body>
  {!useOldNav ? (
    <div class="page" id="page-wrapper">
      <!-- Mobile Menu Toggle and Items -->
      <span class="menu_toggle" id="menu-toggle">
        <i class="menu_open fa fa-bars"></i>
        <i class="menu_close fa fa-times"></i>
      </span>
      <ul class="menu_items">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class:list={[{ 'active': link.href === '/' ? currentPath === '/' : currentPath === link.href || currentPath.startsWith(link.href + '/') }]}>
              <i class={`icon fa ${link.icon} fa-2x`}></i> {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Main Content rotated by the animation -->
      <div class="content" id="page-content">
        <div class="content_inner" id="main-scroll-container">
          <div class="particles-bg" aria-hidden="true"></div>
          <div class="site-layer">
            <Header useOldNav={useOldNav} />
            
            {isHomePage ? (
              <main>
                <slot />
              </main>
            ) : (
              <main>
                <div class="container py-8">
                  <slot />
                </div>
              </main>
            )}
            
            {showFooter && <Footer />}
          </div>
        </div>
      </div>
    </div>
  ) : (
    <>
      <div class="particles-bg" aria-hidden="true"></div>
      <div class="site-layer">
        <Header useOldNav={useOldNav} />
        
        {isHomePage ? (
          <main>
            <slot />
          </main>
        ) : (
          <main>
            <div class="container py-8">
              <slot />
            </div>
          </main>
        )}
        
        {showFooter && <Footer />}
      </div>
    </>
  )}
  
  <script is:inline>
    // Netlify Identity Widget
    (function() {
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', function(user) {
          if (!user) {
            window.netlifyIdentity.on('login', function() {
              document.location.href = '/admin/';
            });
          }
        });
      }
    })();
    
    // Image protection script
    document.addEventListener('DOMContentLoaded', function() {
      // Disable right-click on images
      const images = document.querySelectorAll('img');
      images.forEach(img => {
        // Prevent context menu on right click
        img.addEventListener('contextmenu', function(e) {
          e.preventDefault();
          return false;
        });
        
        // Prevent drag and drop
        img.addEventListener('dragstart', function(e) {
          e.preventDefault();
          return false;
        });
        
        // Optional: Add a visual indicator that protects images
        img.style.setProperty('-webkit-user-select', 'none');
        img.style.setProperty('-moz-user-select', 'none');
        img.style.setProperty('-ms-user-select', 'none');
        img.style.setProperty('user-select', 'none');
      });
      
      // Global right-click prevention on images (as backup)
      document.body.addEventListener('contextmenu', function(e) {
        if (e.target.tagName === 'IMG') {
          e.preventDefault();
          return false;
        }
      });
    });

    // Track specific link clicks globally (outside DOMContentLoaded for speed)
    document.addEventListener('click', function(e) {
      if (typeof gtag !== 'function') return;

      const target = e.target.closest('.phone-link, .whatsapp-link, .email-link, .map-link, .product-card');
      if (!target) return;

      let eventName = 'engagement';
      let label = target.textContent?.trim() || 'Link';
      
      if (target.classList.contains('phone-link')) {
        eventName = 'contact_click';
        label = 'Phone Call';
      } else if (target.classList.contains('whatsapp-link')) {
        eventName = 'contact_click';
        label = 'WhatsApp Chat';
      } else if (target.classList.contains('email-link')) {
        eventName = 'contact_click';
        label = 'Email Send';
      } else if (target.classList.contains('map-link')) {
        eventName = 'contact_click';
        label = 'Google Maps Directions';
      } else if (target.classList.contains('product-card')) {
        eventName = 'product_view';
        label = target.querySelector('.product-name')?.textContent || 'Product Card';
      }

      gtag('event', eventName, {
        'event_category': 'Global Engagement',
        'event_label': label,
        'value': 1
      });
    });
  </script>

  <script is:inline>
    // JS for shazam mobile nav
    document.addEventListener('DOMContentLoaded', () => {
      const page = document.getElementById('page-wrapper');
      const menuToggle = document.getElementById('menu-toggle');
      const content = document.getElementById('page-content');
      let savedScroll = 0;
      
      function openMenu() {
        if (!page) return;
        savedScroll = window.scrollY;
        
        // Lock body precisely at scroll position to prevent jumps
        document.body.style.position = 'fixed';
        document.body.style.top = `-${savedScroll}px`;
        document.body.style.width = '100%';
        
        // Anchor rotation to the exact scrolled viewport
        content.style.transformOrigin = `0px ${savedScroll}px`;
        
        page.classList.add('shazam');
        document.body.classList.add('shazam-open');
      }
      
      function closeMenu() {
        if (!page) return;
        
        page.classList.remove('shazam');
        document.body.classList.remove('shazam-open');
        
        // Remove fixed positioning
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        
        // Restore exact scroll position
        window.scrollTo(0, savedScroll);
        
        // Clean up origin after animation
        setTimeout(() => {
          if (!page.classList.contains('shazam')) {
            content.style.transformOrigin = '';
          }
        }, 700);
      }
      
      if (menuToggle && page) {
        menuToggle.addEventListener('click', () => {
          if (page.classList.contains('shazam')) {
            closeMenu();
          } else {
            openMenu();
          }
        });
      }
      if (content && page) {
        content.addEventListener('click', () => {
          if (page.classList.contains('shazam')) {
            closeMenu();
          }
        });
      }
    });
  </script>

  <style is:global>
    /* Mobile Nav Animation Styles */
    :root {
      --shazam-red: #c5a028; /* adapting to gold instead of red */
      --shazam-bg: #0f172a; /* adapting to dark theme instead of brown */
      --shazam-white: #f0f0f0;
      --shazam-snap: cubic-bezier(1.000, 0.005, 0.240, 1.000);
      --shazam-bounce: cubic-bezier(0.175, 0.885, 0.320, 1.275);
    }

    /* Desktop - base defaults */
    .page { width: 100%; position: relative; }
    .content { width: 100%; }
    .content_inner { width: 100%; }

    @media (max-width: 768px) {
      /* Base state: allow normal scrolling */
      html.shazam-layout {
        margin: 0;
        padding: 0;
        background-color: var(--shazam-bg);
      }
      html.shazam-layout body {
        margin: 0;
        padding: 0;
        background-color: var(--shazam-bg);
      }

      html.shazam-layout .page#page-wrapper {
        position: relative;
        background-color: var(--shazam-bg);
        transition: none;
      }

      .page#page-wrapper .content {
        transition: transform .7s var(--shazam-snap);
        background-color: #0f172a;
      }
      
      html.shazam-layout .page.shazam .content {
        will-change: transform;
      }

      /* Normal state: content_inner is just a normal wrapper */
      .content_inner {
        position: relative;
      }
      
      .menu_toggle {
        z-index: 900;
        position: fixed;
        top: 140px;
        left: 0;
        transform: translateX(-50%);
        display: flex;
        justify-content: flex-end;
        align-items: center;
        padding-right: 10px;
        cursor: pointer;
        width: 60px;
        height: 50px;
        background-color: rgba(197, 160, 40, 0.5);
        border-radius: 0 30px 30px 0;
        backdrop-filter: blur(6px);
        animation: side-pulse 3s infinite alternate ease-in-out;
        box-shadow: 2px 4px 12px rgba(0,0,0,0.3);
        border: 1px solid rgba(255,255,255,0.1);
        border-left: none;
        -webkit-tap-highlight-color: transparent;
        will-change: transform, opacity;
        contain: layout style;
      }
      
      @keyframes side-pulse {
        0% { transform: translateX(-55%); opacity: 0.7; }
        100% { transform: translateX(-35%); opacity: 1; }
      }
      
      .menu_toggle:active { transform: translateX(-35%) scale(0.9); }
      .menu_toggle i { color: #fff; font-size: 1.1rem; }
      
      .menu_open, .menu_close {
        position: absolute;
        transition: transform .7s var(--shazam-snap), opacity .3s;
      }
      .menu_close {
        opacity: 0;
        transform: rotate(90deg);
      }
      
      /* Open state updates */
      .page.shazam .menu_open { opacity: 0; transform: rotate(-90deg); }
      .page.shazam .menu_close { opacity: 1; transform: rotate(0); }
      
      .menu_items {
        position: fixed;
        bottom: 0;
        left: 20px;
        list-style-type: none;
        margin: 0;
        padding: 0;
        z-index: 800;
      }
      .menu_items li {
        height: 60px;
        margin-bottom: 30px;
        transform: translateX(-300px);
        transition: transform .7s 0s var(--shazam-snap);
      }
      .menu_items li:nth-child(2) { margin-left: 20px; }
      .menu_items li:nth-child(3) { margin-left: 40px; }
      .menu_items li:nth-child(4) { margin-left: 60px; }
      
      .menu_items a {
        display: flex;
        align-items: center;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #94a3b8;
        transition: color .2s;
        font-weight: 600;
      }
      .menu_items a .icon {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 25px;
        color: var(--shazam-white);
        width: 40px;
        height: 40px;
      }
      .menu_items a .icon:after {
        position: absolute;
        top: 50%;
        left: 50%;
        content: '';
        display: block;
        width: 60px;
        height: 60px;
        margin-left: -30px;
        margin-top: -30px;
        border-radius: 100%;
        border: 2px solid var(--shazam-white);
        transition: border-color .2s;
      }
      .menu_items a:hover, .menu_items a.active { color: var(--shazam-white); }
      .menu_items a:hover .icon:after, .menu_items a.active .icon:after { border-color: var(--shazam-red); }
      .menu_items a:active .icon { color: var(--shazam-red); }
      
      /* Open State */
      .page.shazam .content { transform: rotate(-30deg); }
      .page.shazam .menu_open { transform: rotate(-20deg); }
      .page.shazam .menu_close { transform: rotate(0); }
      .page.shazam .menu_items li {
        transform: translateX(0);
        transition: transform .35s .45s var(--shazam-bounce);
      }
      .page.shazam .menu_items li:nth-child(2) { transition-delay: .47s; }
      .page.shazam .menu_items li:nth-child(3) { transition-delay: .48s; }
      .page.shazam .menu_items li:nth-child(4) { transition-delay: .49s; }
    }

    @media (min-width: 769px) {
      .menu_toggle, .menu_items { display: none !important; }
    }
  </style>

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline></script>
</body>
</html>