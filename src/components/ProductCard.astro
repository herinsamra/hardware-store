---
// src/components/ProductCard.astro
import { getProductUrl } from '../lib/products';

export interface Props {
  product: {
    id: string;
    name: string;
    price: number;
    image: string;
    category: string;
    brand?: string;
    slug?: string;
    routeParam?: string;
    url?: string;
    variant_name?: string;
    variants?: { variant_id: string; price: number; sku?: string; part_no?: string; images?: string[] }[];
  };
}

const { product } = Astro.props;
const productUrl = getProductUrl(product);
const toTitleCase = (str = '') => {
  return str.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
};
const cleanName = (value = '') => toTitleCase(value.replace(/_/g, ' '));

function formatIndianNumber(num: number): string {
  const absNum = Math.abs(num);
  const integerPart = Math.floor(absNum).toString();
  const decimalPart = num % 1 !== 0 ? '.' + Math.round((num % 1) * 100).toString().padStart(2, '0') : '';
  if (absNum < 1000) return integerPart + decimalPart;
  const lastThree = integerPart.slice(-3);
  const rest = integerPart.slice(0, -3);
  const restFormatted = rest.replace(/\B(?=(\d{2})+(?!\d))/g, ',');
  const formattedInteger = rest.length > 0 ? `${restFormatted},${lastThree}` : lastThree;
  return formattedInteger + decimalPart;
}
---

<div 
  class="product-card group" 
  data-href={productUrl}
  data-astro-prefetch
  role="link"
  tabindex="0"
  aria-label={`View ${product.name}${product.variant_name ? `, ${product.variant_name} variant` : ''}`}
>
  <div class="product-image-wrapper">
    {product.image ? (
      <img 
        src={product.image} 
        alt={`${product.name}${product.variant_name ? ` - ${product.variant_name}` : ''}`}
        class="product-image"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="product-image-placeholder" aria-hidden="true">
        <span>No Image</span>
      </div>
    )}
  </div>
  <div class="product-info">
    <h3 class="product-name">{toTitleCase(product.name)}</h3>
    {product.variant_name && (!product.variants || product.variants.length === 0) && (
      <p class="product-variant">{cleanName(product.variant_name)}</p>
    )}
    {product.price && Number(product.price) > 0 && (
      <div class="product-price" aria-label={`Price: ${formatIndianNumber(product.price)} rupees`}>MRP: ₹{formatIndianNumber(product.price)}</div>
    )}
    {product.variants && product.variants.length > 0 && (
      <div class="card-variant-pills" role="list" aria-label="Available variants">
        {product.variant_name && (
          <a 
            href={productUrl} 
            class="card-variant-chip active"
            role="listitem"
            aria-label={`${cleanName(product.variant_name)} (currently selected)`}
            aria-current="true"
          >{cleanName(product.variant_name)}</a>
        )}
        {product.variants.slice(0, 4).map((v) => (
          <a 
            href={`${productUrl}?variant=${v.variant_id}`} 
            class="card-variant-chip"
            role="listitem"
            aria-label={`Switch to variant ${v.variant_id}`}
          >{v.variant_id}</a>
        ))}
        {product.variants.length > 4 && (
          <a 
            href={productUrl} 
            class="card-variant-chip more"
            role="listitem"
            aria-label={`${product.variants.length - 4} more variants available`}
          >+{product.variants.length - 4}</a>
        )}
      </div>
    )}
    <div class="product-category" aria-label={`Brand: ${cleanName(product.brand || '')}`}>{cleanName(product.brand || product.category)}</div>
  </div>
</div>

<script>
  document.querySelectorAll('.product-card[data-href]').forEach(card => {
    card.addEventListener('click', (e) => {
      if (e.target.closest('.card-variant-chip')) return;
      window.location.href = card.dataset.href;
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (!e.target.closest('.card-variant-chip')) {
          window.location.href = card.dataset.href;
        }
      }
    });
  });
</script>

<style is:global>
  .product-card {
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.95rem;
    background: linear-gradient(145deg, var(--neo-surface-base), var(--neo-surface-low));
    border-radius: 24px;
    box-shadow:
      10px 10px 20px var(--neo-shadow-dark),
      -10px -10px 20px var(--neo-shadow-light);
    border: 1px solid var(--neo-outline);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    transition:
      transform 0.28s ease,
      box-shadow 0.28s ease,
      border-color 0.28s ease;
    outline: none;
    contain: content;
    -webkit-tap-highlight-color: transparent;
  }
  .product-card:focus-visible {
    box-shadow:
      14px 14px 28px var(--neo-shadow-dark),
      -14px -14px 28px var(--neo-shadow-light),
      0 0 0 3px var(--accent-gold);
    border-color: rgba(197, 160, 40, 0.5);
  }

  .product-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.12), transparent 34%),
      radial-gradient(circle at bottom right, rgba(197, 160, 40, 0.14), transparent 28%);
    pointer-events: none;
  }

  .product-card:hover {
    transform: translateY(-8px);
    border-color: rgba(197, 160, 40, 0.24);
    box-shadow:
      18px 18px 34px rgba(5, 8, 14, 0.72),
      -16px -16px 28px rgba(103, 124, 161, 0.18),
      0 0 0 1px var(--neo-gold-glow);
  }
  .product-image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 20px;
    background: linear-gradient(145deg, var(--neo-surface-high), var(--neo-surface-low));
    box-shadow:
      inset 10px 10px 22px rgba(8, 11, 18, 0.42),
      inset -10px -10px 20px rgba(93, 113, 147, 0.14);
  }

  .product-image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent 35%, rgba(9, 13, 22, 0.18));
    pointer-events: none;
  }
  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .product-card:hover .product-image {
    transform: scale(1.07);
  }
  .product-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.05), rgba(11, 17, 28, 0.28));
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
  .product-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 0.35rem 0.35rem;
  }
  .product-name {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.45rem;
    color: var(--text-primary);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    height: 2.7em;
    text-wrap: balance;
  }
  .product-variant {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(197, 160, 40, 0.12);
    border: 1px solid rgba(197, 160, 40, 0.18);
    color: var(--accent-gold-light);
    font-size: 0.76rem;
    margin-bottom: 0.85rem;
  }
  .product-price {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent-gold);
    margin-bottom: 0.55rem;
    text-shadow: 0 0 18px rgba(197, 160, 40, 0.12);
  }
  .product-category {
    margin-top: auto;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    box-shadow:
      inset 4px 4px 8px rgba(6, 10, 17, 0.24),
      inset -3px -3px 6px rgba(96, 116, 150, 0.12);
    font-size: 0.68rem;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
  }

  @media (max-width: 640px) {
    .product-category {
      font-size: 0.58rem;
      padding: 0.25rem 0.5rem;
    }
  }

  @media (max-width: 640px) {
    .product-card {
      padding: 0.6rem;
      border-radius: 16px;
      gap: 0.5rem;
    }
    .product-info { padding: 0 0.1rem 0.1rem; }
    .product-name { 
      font-size: 0.78rem; 
      line-height: 1.3;
      height: 2.6em;
      margin-bottom: 0.35rem;
    }
    .product-price { font-size: 0.95rem; margin-bottom: 0.4rem; }
    .product-image-wrapper { border-radius: 12px; }
  }

  .card-variant-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.65rem;
    position: relative;
    z-index: 1;
  }
  .card-variant-chip {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    z-index: 1;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  @media (max-width: 640px) {
    .card-variant-pills {
      gap: 0.25rem;
      margin-bottom: 0.45rem;
    }
    .card-variant-chip {
      padding: 0.15rem 0.4rem;
      font-size: 0.58rem;
    }
  }
  .card-variant-chip:hover {
    background: rgba(197, 160, 40, 0.12);
    border-color: rgba(197, 160, 40, 0.22);
    color: var(--accent-gold-light);
  }
  .card-variant-chip.active {
    background: rgba(197, 160, 40, 0.12);
    border-color: rgba(197, 160, 40, 0.22);
    color: var(--accent-gold-light);
  }
  .card-variant-chip.more {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    font-style: italic;
  }
</style>
