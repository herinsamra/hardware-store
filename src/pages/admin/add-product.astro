  }

  .unit-flex {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .unit-flex select {
    flex: 1;
  }
  .manage-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
