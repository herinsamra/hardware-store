    --text-secondary: #9ca3af;
    --accent: #c5a028; /* Gold accent from main site */
    --accent-glow: rgba(197, 160, 40, 0.4);
    --error: #ef4444;
    --success: #10b981;
    --input-bg: rgba(15, 17, 23, 0.8);
  }

  body {
    background-color: var(--bg-color);
    background-image: 
      radial-gradient(at 0% 0%, rgba(197, 160, 40, 0.15) 0px, transparent 50%),
      radial-gradient(at 100% 100%, rgba(197, 160, 40, 0.05) 0px, transparent 50%);
