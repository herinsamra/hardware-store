  }
  .variants-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .variants-header h3 {
    margin: 0;
    color: var(--accent);
    font-size: 1.2rem;
  }
  .variant-add-btn {
    background: rgba(197, 160, 40, 0.15);
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0.4rem 1rem;
