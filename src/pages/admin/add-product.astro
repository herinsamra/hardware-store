  }
  @media (max-width: 768px) {
    .variant-row {
      grid-template-columns: 1fr;
    }
    .v-span-full {
      grid-column: 1 / -1;
    }
    .remove-variant-btn {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      margin-top: 0;
    }
  }

  .admin-header {
    margin-bottom: 2.5rem;
  }

  .header-main-row {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .header-main-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .title-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-text-group {
    display: flex;
    flex-direction: column;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .top-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, rgba(197, 160, 40, 0.2), rgba(197, 160, 40, 0.08));
    border: 1px solid var(--accent);
    color: #fff;
    padding: 0.75rem 1.4rem;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2), 0 0 12px rgba(197, 160, 40, 0.15);
    transition: all 0.25s ease;
  }

  .top-action-btn:hover {
    background: linear-gradient(135deg, var(--accent), #eab308);
    color: #000;
    box-shadow: 0 6px 20px rgba(197, 160, 40, 0.4);
    transform: translateY(-2px);
  }

  .top-action-btn .btn-icon {
    font-size: 1.1rem;
    font-weight: 700;
  }

  /* Submitted Product Details Summary Card */
  .submitted-summary-card {
    background: linear-gradient(180deg, rgba(22, 26, 35, 0.95) 0%, rgba(15, 17, 23, 0.98) 100%);
    border: 1px solid rgba(16, 185, 129, 0.45);
    border-radius: 20px;
    padding: 2rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.6), 0 0 30px rgba(16, 185, 129, 0.15);
    animation: fadeInSlide 0.35s ease-out;
  }

  @keyframes fadeInSlide {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .summary-header {
