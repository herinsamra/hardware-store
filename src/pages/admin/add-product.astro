---
import AdminLayout from '../../components/AdminLayout.astro';
---

<AdminLayout title="Add Product | Admin">
  <div class="admin-wrapper">
    <div class="glass-container">
      <header class="admin-header">
        <div class="header-main-row">
          <div class="title-wrapper">
            <div class="icon-box">✦</div>
            <div class="header-text-group">
              <h1>Add New Product</h1>
              <p class="subtitle">AI will generate descriptions, meta tags & slugs automatically</p>
            </div>
          </div>
          <div class="header-actions">
            <button type="button" id="topAddProductBtn" class="top-action-btn" title="Add another product keeping the same category">
              <span class="btn-icon">＋</span> Add New Product
            </button>
          </div>
        </div>
      </header>

      <!-- Submitted Product Details Summary Card -->
      <div id="submittedProductSummary" class="submitted-summary-card" style="display: none;">
        <div class="summary-header">
          <div class="summary-status">
            <span class="status-icon">✓</span>
            <div>
              <h3>Product Saved Successfully!</h3>
              <p class="summary-sub">All entered details and AI generated content have been saved.</p>
            </div>
          </div>
          <div class="summary-top-actions">
            <a id="summaryEditBtn" href="#" class="summary-action-btn edit-btn">
              ✏️ Edit Product
            </a>
            <button type="button" id="summaryAddAnotherBtn" class="summary-action-btn add-btn">
              ＋ Add New Product (Same Category)
            </button>
            <a id="summaryLiveBtn" href="#" target="_blank" class="summary-action-btn live-btn">
              ↗ View Live Page
            </a>
          </div>
        </div>

        <div class="summary-body">
          <!-- Basic Details & Classification -->
          <div class="summary-section">
            <h4 class="summary-section-title">📦 Basic Details & Classification</h4>
            <div class="summary-grid">
              <div class="summary-item">
                <span class="label">Part Number</span>
                <span class="value part-no-badge" id="sum_part_no"></span>
              </div>
              <div class="summary-item">
                <span class="label">Product Name</span>
                <span class="value" id="sum_product_name"></span>
              </div>
              <div class="summary-item">
                <span class="label">Brand</span>
                <span class="value brand-badge" id="sum_brand"></span>
              </div>
              <div class="summary-item">
                <span class="label">Price (MRP)</span>
                <span class="value price-value" id="sum_mrp"></span>
              </div>
              <div class="summary-item">
                <span class="label">Unit</span>
                <span class="value" id="sum_unit"></span>
              </div>
              <div class="summary-item">
                <span class="label">Type</span>
                <span class="value" id="sum_type"></span>
              </div>
              <div class="summary-item">
                <span class="label">Variant Name</span>
                <span class="value" id="sum_variant_name"></span>
              </div>
              <div class="summary-item full-width">
                <span class="label">Category Hierarchy</span>
                <div class="value category-breadcrumb" id="sum_category_path"></div>
              </div>
              <div class="summary-item full-width" id="sum_specs_row" style="display: none;">
                <span class="label">Custom Specifications</span>
                <span class="value" id="sum_custom_features"></span>
              </div>
            </div>
          </div>

          <!-- Media -->
          <div class="summary-section" id="sum_media_section" style="display: none;">
            <h4 class="summary-section-title">🖼️ Media & Visuals</h4>
            <div id="sum_images_preview" class="summary-images-gallery"></div>
            <div class="summary-item" id="sum_video_row" style="display: none; margin-top: 0.8rem;">
              <span class="label">Video URL</span>
              <span class="value" id="sum_video_url"></span>
            </div>
          </div>

          <!-- Variants -->
          <div class="summary-section" id="sum_variants_section" style="display: none;">
            <h4 class="summary-section-title">🔀 Product Variants (<span id="sum_variants_count">0</span>)</h4>
            <div id="sum_variants_list" class="summary-variants-list"></div>
          </div>

          <!-- AI Generated Content -->
          <div class="summary-section ai-summary-section">
            <h4 class="summary-section-title">✨ AI Generated Content</h4>
            <div class="summary-ai-block">
              <div class="ai-block-item">
                <span class="label">Generated Description</span>
                <p class="ai-text-preview" id="sum_description"></p>
              </div>
              <div class="ai-block-item">
                <span class="label">Technical Specifications</span>
                <ul class="ai-specs-list" id="sum_key_features"></ul>
              </div>
              <div class="summary-grid" style="margin-top: 1rem;">
                <div class="summary-item">
                  <span class="label">Meta Title</span>
                  <span class="value" id="sum_meta_title"></span>
                </div>
                <div class="summary-item">
                  <span class="label">Generated Slug</span>
                  <span class="value code-val" id="sum_slug"></span>
                </div>
                <div class="summary-item full-width">
                  <span class="label">Meta Description</span>
                  <span class="value" id="sum_meta_description"></span>
                </div>
              </div>
              <div class="summary-item full-width" id="sum_slogan_row" style="display: none; margin-top: 0.8rem;">
                <span class="label">Featured Slogan</span>
                <span class="value slogan-val" id="sum_slogan"></span>
              </div>
            </div>
          </div>
        </div>

        <div class="summary-bottom-actions">
          <a id="summaryEditBtnBottom" href="#" class="summary-action-btn edit-btn">
            ✏️ Edit Product
          </a>
          <button type="button" id="summaryAddAnotherBtnBottom" class="summary-action-btn add-btn">
            ＋ Add New Product (Same Category)
          </button>
        </div>
      </div>

      <form id="productForm" class="product-form">
        <div class="form-grid">
          <!-- Manual Inputs -->
          <div class="form-section">
            <h2 class="section-title">Product Details</h2>
            
            <div class="input-group">
              <label for="part_no">Part Number <span class="required">*</span></label>
              <div class="input-wrapper">
                <input type="text" id="part_no" required placeholder="e.g., ZZ00926" autocomplete="off" aria-describedby="part_no_status">
                <div class="focus-border"></div>
              </div>
              <p class="field-status" id="part_no_status" aria-live="polite"></p>
            </div>

            <div class="input-group">
              <label for="product_name">Product Name <span class="required">*</span></label>
              <div class="input-wrapper">
                <input type="text" id="product_name" required placeholder="Enter product name" autocomplete="off">
                <div class="focus-border"></div>
              </div>
            </div>

            <div class="input-group">
              <label for="brand">Brand <span class="required">*</span></label>
              <div class="input-wrapper">
                <select id="brand" required></select>
                <div class="focus-border"></div>
              </div>
            </div>

            <div class="input-group">
              <label for="type">Type</label>
              <div class="input-wrapper">
                <input type="text" id="type" placeholder="e.g., PIPE MOUNT" autocomplete="off">
                <div class="focus-border"></div>
              </div>
            </div>

            <div class="input-group">
              <label for="variant_name">Variant Name <span class="optional">(optional)</span></label>
              <div class="input-wrapper">
                <input type="text" id="variant_name" placeholder="e.g., Red, 10mm" autocomplete="off">
                <div class="focus-border"></div>
              </div>
            </div>

            <div class="input-group">
              <label for="mrp">MRP (₹) <span class="required">*</span></label>
              <div class="input-wrapper">
                <input type="number" id="mrp" step="0.01" required placeholder="0.00" autocomplete="off">
                <div class="focus-border"></div>
              </div>
            </div>

            <div class="input-group">
              <label for="unit">Unit <span class="optional">(optional, e.g. per meter)</span></label>
              <div class="input-wrapper unit-flex">
                <select id="unit">
                  <option value="">-- No Unit --</option>
                </select>
                <a href="/admin/units" class="manage-btn" title="Manage Units">⚙️</a>
                <div class="focus-border"></div>
              </div>
            </div>

            <div class="input-group full-width image-upload-group" id="imageUploadGroup">
              <div class="field-label-row">
                <label for="images">Product Images <span class="optional">(Cloudinary or comma separated URLs)</span></label>
                <span class="image-count-badge" id="imageCountBadge" style="display: none;">0 images</span>
              </div>
              <div class="image-input-container">
                <div class="input-wrapper image-input-wrapper">
                  <input type="text" id="images" placeholder="https://res.cloudinary.com/... or click Upload Image ➜" autocomplete="off">
                  <div class="focus-border"></div>
                </div>
                <input type="file" id="imageFileInput" accept="image/*" multiple style="display: none;">
                <button type="button" id="uploadImageBtn" class="upload-img-btn" title="Upload image(s) to Cloudinary">
                  <span class="upload-btn-icon">☁️</span>
                  <span class="upload-btn-text">Upload Image</span>
                  <div class="upload-spinner" style="display: none;"></div>
                </button>
              </div>

              <!-- Background Removal Toggle -->
              <div class="bgremove-toggle-row" id="bgRemoveToggleRow">
                <label class="bgremove-toggle-label" for="bgRemoveToggle">
                  <input type="checkbox" id="bgRemoveToggle">
                  <span class="bgremove-switch"></span>
                  <span class="bgremove-label-text">
                    <span class="bgremove-icon">✂️</span> Remove Background
                  </span>
                  <span class="bgremove-hint">(auto-removes before upload)</span>
                </label>
              </div>

              <!-- BgRemove Progress -->
              <div id="bgRemoveProgress" class="bgremove-progress" style="display: none;">
                <div class="bgremove-progress-header">
                  <span class="bgremove-progress-icon">✂️</span>
                  <span class="bgremove-progress-label">Removing background...</span>
                  <span class="bgremove-progress-pct" id="bgRemoveProgressPct">0%</span>
                </div>
                <div class="bgremove-progress-bar">
                  <div class="bgremove-progress-fill" id="bgRemoveProgressFill"></div>
                </div>
                <p class="bgremove-progress-status" id="bgRemoveProgressStatus">Preparing model...</p>
              </div>

              <!-- Upload Feedback -->
              <div id="uploadFeedback" class="upload-feedback" style="display: none;"></div>

              <!-- Live Image Preview Gallery Before Saving -->
              <div id="imagePreviewContainer" class="image-preview-gallery" style="display: none;"></div>
            </div>

            <div class="input-group full-width video-upload-group" id="videoUploadGroup">
              <div class="field-label-row">
                <label for="video_url">Video URL <span class="optional">(Cloudinary video or upload directly)</span></label>
                <span class="video-status-badge" id="videoStatusBadge" style="display: none;">Video attached</span>
              </div>
              <div class="video-input-container">
                <div class="input-wrapper video-input-wrapper">
                  <input type="text" id="video_url" placeholder="https://res.cloudinary.com/.../video.mp4 or click Upload Video ➜" autocomplete="off">
                  <div class="focus-border"></div>
                </div>
                <input type="file" id="videoFileInput" accept="video/*" style="display: none;">
                <button type="button" id="uploadVideoBtn" class="upload-vid-btn" title="Upload a product video directly to Cloudinary">
                  <span class="upload-vid-icon">🎥</span>
                  <span class="upload-vid-text">Upload Video</span>
                  <div class="upload-vid-spinner" style="display: none;"></div>
                </button>
              </div>

              <!-- Video Upload Feedback -->
              <div id="videoUploadFeedback" class="upload-feedback" style="display: none;"></div>

              <!-- Live Video Preview Player Before Saving -->
              <div id="videoPreviewContainer" class="video-preview-card" style="display: none;"></div>
            </div>

            <div class="input-group full-width">
              <label for="custom_features">Custom Specifications <span class="optional">(optional)</span></label>
              <div class="input-wrapper">
                <input type="text" id="custom_features" placeholder="e.g., Material: Brass, Finish: Chrome, Size: 600 mm" autocomplete="off">
                <div class="focus-border"></div>
              </div>
            </div>
          </div>

          <!-- Classification -->
          <div class="form-section">
            <h2 class="section-title">Classification</h2>
            
            <div class="input-group">
              <label for="category">Category <span class="required">*</span></label>
              <div class="input-wrapper">
                <select id="category" required></select>
                <div class="focus-border"></div>
              </div>
            </div>

            <div class="input-group">
              <label for="subcategory">Subcategory <span class="required">*</span></label>
              <div class="input-wrapper">
                <select id="subcategory" required disabled></select>
                <div class="focus-border"></div>
              </div>
            </div>

            <div class="input-group">
              <label for="subsubcategory">Sub‑subcategory <span class="required">*</span></label>
              <div class="input-wrapper">
                <div id="subsubcategory" class="checkbox-group-container" style="padding: 0.5rem; background: var(--input-bg); border-radius: 8px; border: 1px solid var(--glass-border); min-height: 48px; max-height: 200px; overflow-y: auto;">
                  <span class="placeholder-text" style="color: var(--text-secondary); opacity: 0.7;">-- Select Sub-subcategory --</span>
                </div>
                <div class="focus-border"></div>
              </div>
            </div>

            <div class="input-group featured-toggle">
              <label class="checkbox-label" for="is_featured">
                <input type="checkbox" id="is_featured">
                <span class="custom-checkbox"></span>
                Feature this product? <span class="badge new-badge">NEW</span>
              </label>
              <p class="hint">Featured products will get a special AI slogan and show up as ads in listings.</p>
            </div>

            <div id="featuredSettings" style="display: none; margin-bottom: 2rem; padding: 1.5rem; background: rgba(197, 160, 40, 0.05); border-radius: 16px; border: 1px dashed rgba(197, 160, 40, 0.3);">
                <div class="input-group">
                  <label style="color: var(--accent-gold); font-size: 0.9rem; font-weight: 600; margin-bottom: 0.8rem; display: block;">Link Destination</label>
                  <div class="destination-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.8rem;">
                    <label class="dest-option">
                      <input type="radio" name="featured_link_type" value="product" checked />
                      <div class="dest-card">
                        <span class="icon">📦</span>
                        <span class="label">Product Page</span>
                      </div>
                    </label>

                    <label class="dest-option">
                      <input type="radio" name="featured_link_type" value="category" />
                      <div class="dest-card">
                        <span class="icon">📁</span>
                        <span class="label">Category</span>
                      </div>
                    </label>

                    <label class="dest-option">
                      <input type="radio" name="featured_link_type" value="subcategory" />
                      <div class="dest-card">
                        <span class="icon">📂</span>
                        <span class="label">Subcategory</span>
                      </div>
                    </label>

                    <label class="dest-option">
                      <input type="radio" name="featured_link_type" value="subsubcategory" />
                      <div class="dest-card">
                        <span class="icon">📂</span>
                        <span class="label">Sub-subcat</span>
                      </div>
                    </label>

                    <label class="dest-option">
                      <input type="radio" name="featured_link_type" value="brand" />
                      <div class="dest-card">
                        <span class="icon">🏷️</span>
                        <span class="label">Brand Page</span>
                      </div>
                    </label>
                  </div>
                </div>

                <div class="input-group" style="margin-top: 1.5rem;">
                  <label for="featured_link" style="color: var(--accent-gold); font-size: 0.9rem; font-weight: 600; margin-bottom: 0.5rem; display: block;">Manual URL Override (Optional)</label>
                  <div class="input-wrapper">
                    <input type="text" id="featured_link" placeholder="Leave empty to use selection above">
                    <div class="focus-border"></div>
                  </div>
                </div>

                <div class="input-group" style="margin-top: 1rem;">
                  <label for="featured_button_text" style="color: var(--accent-gold); font-size: 0.9rem; font-weight: 600; margin-bottom: 0.5rem; display: block;">Button Text (Optional)</label>
                  <div class="input-wrapper">
                    <input type="text" id="featured_button_text" placeholder="e.g. View Collection">
                    <div class="focus-border"></div>
                  </div>
                  <p class="hint">e.g. "View Collection", "Shop Now", etc.</p>
                </div>
            </div>

            <!-- AI Preview Area -->
            <div class="ai-preview-section">
              <div class="ai-header">
                <span class="ai-icon">✨</span>
                <h3>AI Generation Preview</h3>
              </div>
              <p class="ai-hint">These fields will be automatically generated by AI upon submission.</p>
              
              <div class="ai-field">
                <label>Description</label>
                <textarea id="description" rows="3" readonly placeholder="Waiting for generation..."></textarea>
              </div>

              <div class="ai-field">
                <label>Technical Specifications</label>
                <textarea id="key_features" rows="4" readonly placeholder="Technical specification points will appear here..."></textarea>
              </div>
              
              <div class="ai-field">
                <label>Meta Title</label>
                <input type="text" id="meta_title" readonly placeholder="...">
              </div>
              
              <div class="ai-field">
                <label>Meta Description</label>
                <textarea id="meta_description" rows="2" readonly placeholder="..."></textarea>
              </div>
              
              <div class="ai-field">
                <label>Generated Slug</label>
                <input type="text" id="slug" readonly placeholder="...">
              </div>

              <div class="ai-field slogan-field" id="sloganPreview" style="display: none;">
                <label>Featured Slogan</label>
                <input type="text" id="slogan" readonly placeholder="Captivating slogan will appear here...">
              </div>
            </div>
          </div>
        </div>

        <!-- Variants Section -->
        <div class="variants-section glass-panel">
          <div class="variants-header">
            <h3>Product Variants</h3>
            <button type="button" id="addVariantBtn" class="button variant-add-btn">+ Add Variant</button>
          </div>
          <p class="hint">Add variations like sizes, colors, or amperages. If a variant has no image, it inherits the main product's images.</p>
          <div id="variantsContainer" class="variants-container"></div>
        </div>

        <div class="form-footer">
          <div id="message" class="message"></div>
          <div class="footer-actions">
            <button type="submit" class="submit-btn" id="submitBtn">
              <span class="btn-text">Generate AI & Save Product</span>
              <span class="btn-icon">→</span>
              <div class="btn-loader"></div>
            </button>
            <button type="button" id="addAnotherBtn" class="add-another-btn" style="display: none;">
              <span class="btn-text">+ Add New Product (Same Category)</span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- BgRemove SDK -->
  <script src="https://bgremovers.org/sdk/v1.js" defer></script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      let categories = {};
      let brands = [];

      const catSelect = document.getElementById('category');
      const subcatSelect = document.getElementById('subcategory');
      const subsubSelect = document.getElementById('subsubcategory');
      const brandSelect = document.getElementById('brand');

      function resetSelect(select, placeholder, disabled = false) {
        select.innerHTML = '';
        const option = document.createElement('option');
        option.value = '';
        option.textContent = placeholder;
        select.appendChild(option);
        select.disabled = disabled;
      }

      function resetCheckboxGroup(container, placeholder) {
        container.innerHTML = `<span class="placeholder-text" style="color: var(--text-secondary); opacity: 0.7; padding: 0.5rem; display: block;">${placeholder}</span>`;
      }

      // Populate placeholders initially
      resetSelect(catSelect, 'Loading Categories...', true);
      resetSelect(subcatSelect, '-- Select Subcategory --', true);
      resetCheckboxGroup(subsubSelect, '-- Select Sub-subcategory --');
      resetSelect(brandSelect, 'Loading Brands...', true);
      const unitSelect = document.getElementById('unit');
      if (unitSelect) resetSelect(unitSelect, 'Loading Units...', true);

      try {
        const [catRes, brandRes, unitRes] = await Promise.all([
          fetch('/api/get-categories', { cache: 'no-store' }).catch(() => ({ ok: false })),
          fetch('/api/get-brands', { cache: 'no-store' }).catch(() => ({ ok: false })),
          fetch('/api/get-units', { cache: 'no-store' }).catch(() => ({ ok: false }))
        ]);
        
        if (catRes.ok) {
          const rawCat = await catRes.json();
          const { Brands, ...rest } = rawCat;
          categories = rest;
        }

        if (brandRes.ok) {
          brands = await brandRes.json();
        }

        // Always reset and enable Brand select
        resetSelect(brandSelect, '-- Select Brand --');
        if (brands.length) {
          brands.forEach(brand => {
            const option = document.createElement('option');
            option.value = brand.name;
            option.textContent = brand.name;
            brandSelect.appendChild(option);
          });
        }

        // Always reset and enable Category select
        resetSelect(catSelect, '-- Select Category --');
        Object.keys(categories).forEach(cat => {
          const option = document.createElement('option');
          option.value = cat;
          option.textContent = cat.replace(/_/g, ' ');
          catSelect.appendChild(option);
        });

        // Always reset and enable Unit select
        if (unitSelect) {
          resetSelect(unitSelect, '-- No Unit --');
          if (unitRes.ok) {
            const units = await unitRes.json();
            units.forEach(unit => {
              const option = document.createElement('option');
              option.value = unit;
              option.textContent = unit;
              unitSelect.appendChild(option);
            });
          }
        }
      } catch (err) {
        console.error('Failed to load data', err);
        // Ensure they are enabled even on error
        resetSelect(catSelect, '-- Error Loading Categories --');
        resetSelect(brandSelect, '-- Error Loading Brands --');
        if (unitSelect) resetSelect(unitSelect, '-- Error Loading Units --');
      }


      // Form submission
      catSelect.addEventListener('change', () => {
        const selectedCat = catSelect.value;
        const subcats = categories[selectedCat] || {};
        resetSelect(subcatSelect, '-- Select Subcategory --', !selectedCat);
        resetCheckboxGroup(subsubSelect, '-- Select Sub-subcategory --');

        if (!selectedCat) return;

        Object.keys(subcats).forEach(sub => {
          const opt = document.createElement('option');
          opt.value = sub;
          opt.textContent = sub.replace(/_/g, ' ');
          subcatSelect.appendChild(opt);
        });
      });

      // Subcategory change -> subsubcategory
      subcatSelect.addEventListener('change', () => {
        const selectedCat = catSelect.value;
        const selectedSub = subcatSelect.value;
        const subsubs = categories[selectedCat]?.[selectedSub] || {};
        
        if (!selectedSub || Object.keys(subsubs).length === 0) {
          resetCheckboxGroup(subsubSelect, '-- Select Sub-subcategory --');
          return;
        }

        subsubSelect.innerHTML = '';
        Object.keys(subsubs).forEach(subsub => {
          const label = document.createElement('label');
          label.className = 'checkbox-label';
          label.style.display = 'flex';
          label.style.alignItems = 'center';
          label.style.padding = '0.5rem';
          label.style.cursor = 'pointer';
          label.style.borderBottom = '1px solid var(--glass-border)';

          const input = document.createElement('input');
          input.type = 'checkbox';
          input.value = subsub;
          input.className = 'subsub-checkbox';

          const customCb = document.createElement('div');
          customCb.className = 'custom-checkbox';

          const textSpan = document.createElement('span');
          textSpan.textContent = subsub.replace(/_/g, ' ');

          label.appendChild(input);
          label.appendChild(customCb);
          label.appendChild(textSpan);
          subsubSelect.appendChild(label);
        });
        if (subsubSelect.lastChild) {
           subsubSelect.lastChild.style.borderBottom = 'none';
        }
      });

      // Helper function to find case-insensitive & space/underscore keys
      function findCategoryKey(dict, target) {
        if (!dict || !target) return null;
        if (dict[target]) return target;
        const normTarget = target.trim().toLowerCase().replace(/[\s_]+/g, '_');
        return Object.keys(dict).find(k => {
          const normKey = k.toLowerCase().replace(/[\s_]+/g, '_');
          return normKey === normTarget;
        }) || null;
      }

      // Populate from URL Parameters
      const urlParams = new URLSearchParams(window.location.search);
      const preCat = urlParams.get('category');
      const preSub = urlParams.get('subcategory');
      const preSubSub = urlParams.get('subsub') || urlParams.get('subsubcategory');

      if (preCat) {
        const matchedCat = findCategoryKey(categories, preCat);
        if (matchedCat) {
          catSelect.value = matchedCat;
          catSelect.dispatchEvent(new Event('change'));

          if (preSub) {
            const subcats = categories[matchedCat] || {};
            const matchedSub = findCategoryKey(subcats, preSub);
            if (matchedSub) {
              subcatSelect.value = matchedSub;
              subcatSelect.dispatchEvent(new Event('change'));

              if (preSubSub) {
                const preSubSubs = preSubSub.split(',').map(s => s.trim().toLowerCase().replace(/[\s_]+/g, '_'));
                const checkboxes = subsubSelect.querySelectorAll('.subsub-checkbox');
                checkboxes.forEach(cb => {
                  const normCb = cb.value.toLowerCase().replace(/[\s_]+/g, '_');
                  if (preSubSubs.includes(normCb)) {
                    cb.checked = true;
                  }
                });
              }
            }
          }
        }
      }

      // Form submission
      const form = document.getElementById('productForm');
      const messageDiv = document.getElementById('message');
      const submitBtn = document.getElementById('submitBtn');
      const partNoInput = document.getElementById('part_no');
      const partNoStatus = document.getElementById('part_no_status');
      let partNoCheckTimer = null;
      let partNoCheckRequestId = 0;
      let partNoDuplicateExists = false;
      let partNoCheckPending = false;

      function normalizePartNo(value) {
        return value.trim().toUpperCase();
      }

      function setPartNoStatus(message = '', type = '') {
        if (!partNoStatus) return;
        partNoStatus.textContent = message;
        partNoStatus.className = `field-status ${type}`.trim();
      }

      function updateSubmitAvailability() {
        if (!submitBtn) return;
        submitBtn.disabled = partNoDuplicateExists || partNoCheckPending;
      }

      function resetPartNoCheck() {
        partNoDuplicateExists = false;
        partNoCheckPending = false;
        setPartNoStatus();
        updateSubmitAvailability();
      }

      async function checkPartNoAvailability(rawPartNo) {
        const partNo = normalizePartNo(rawPartNo);
        const requestId = ++partNoCheckRequestId;

        if (!partNo) {
          resetPartNoCheck();
          return;
        }

        partNoCheckPending = true;
        partNoDuplicateExists = false;
        setPartNoStatus('Checking part number...', 'checking');
        updateSubmitAvailability();

        try {
          const response = await fetch(`/api/check-part-no?part_no=${encodeURIComponent(partNo)}`, {
            cache: 'no-store',
          });

          if (requestId !== partNoCheckRequestId) return;

          if (!response.ok) {
            throw new Error('Check failed');
          }

          const result = await response.json();
          partNoCheckPending = false;
          partNoDuplicateExists = Boolean(result.exists);

          if (partNoDuplicateExists) {
            const existingName = result.product?.product_name ? `: ${result.product.product_name}` : '';
            setPartNoStatus(`This part number already exists${existingName}.`, 'error');
          } else {
            setPartNoStatus('Part number is available.', 'success');
          }
        } catch (error) {
          if (requestId !== partNoCheckRequestId) return;
          partNoCheckPending = false;
          partNoDuplicateExists = false;
          setPartNoStatus('Could not check now. Submit will still validate it.', 'warning');
        } finally {
          if (requestId === partNoCheckRequestId) updateSubmitAvailability();
        }
      }

      if (partNoInput) {
        partNoInput.addEventListener('input', () => {
          const normalized = normalizePartNo(partNoInput.value);
          if (partNoInput.value !== normalized) {
            partNoInput.value = normalized;
          }

          window.clearTimeout(partNoCheckTimer);
          partNoCheckTimer = window.setTimeout(() => {
            checkPartNoAvailability(partNoInput.value);
          }, 350);
        });

        partNoInput.addEventListener('blur', () => {
          window.clearTimeout(partNoCheckTimer);
          checkPartNoAvailability(partNoInput.value);
        });
      }

      function showMessage(msg, type) {
        messageDiv.textContent = msg;
        messageDiv.className = `message ${type}`;
        messageDiv.style.display = 'block';
        
        // Hide message after 5 seconds if success
        if(type === 'success') {
          setTimeout(() => {
            messageDiv.style.opacity = '0';
            setTimeout(() => {
              messageDiv.style.display = 'none';
              messageDiv.style.opacity = '1';
            }, 300);
          }, 5000);
        }
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        messageDiv.style.display = 'none';

        const subsubCheckboxes = Array.from(document.querySelectorAll('.subsub-checkbox:checked')).map(cb => cb.value);
        const subsubValue = subsubCheckboxes.join(', ');

        const payload = {
          part_no: document.getElementById('part_no').value,
          category: document.getElementById('category').value,
          subcategory: document.getElementById('subcategory').value,
          subsubcategory: subsubValue,
          type: document.getElementById('type').value,
          product_name: document.getElementById('product_name').value,
          brand: document.getElementById('brand').value,
          images: document.getElementById('images').value,
          video_url: document.getElementById('video_url').value,
          custom_features: document.getElementById('custom_features').value,
          variant_name: document.getElementById('variant_name').value,
          mrp: document.getElementById('mrp').value,
          unit: document.getElementById('unit').value,
          is_featured: document.getElementById('is_featured').checked,
          featured_link: document.getElementById('featured_link').value,
          featured_link_type: document.querySelector('input[name="featured_link_type"]:checked')?.value || 'product',
          featured_button_text: document.getElementById('featured_button_text').value,
          variants: getVariantsData(),
        };

        if (!payload.part_no || !payload.category || !payload.subcategory || !payload.subsubcategory || !payload.product_name || !payload.brand || !payload.mrp) {
          showMessage('Please fill all required fields', 'error');
          return;
        }

        if (partNoCheckPending) {
          showMessage('Please wait for the part number check to finish.', 'error');
          partNoInput?.focus();
          return;
        }

        if (partNoDuplicateExists) {
          showMessage('This part number already exists. Please use a different part number.', 'error');
          partNoInput?.focus();
          return;
        }

        submitBtn.classList.add('loading');

        try {
          const response = await fetch('/api/add-product', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const result = await response.json();

          if (response.ok) {
            document.getElementById('description').value = result.product.description || '';
            const features = result.product.key_features ? (typeof result.product.key_features === 'string' ? JSON.parse(result.product.key_features) : result.product.key_features) : [];
            document.getElementById('key_features').value = features.map(feature => `- ${feature}`).join('\n');
            document.getElementById('meta_title').value = result.product.meta_title || '';
            document.getElementById('meta_description').value = result.product.meta_description || '';
            document.getElementById('slug').value = result.product.slug || '';
            if (result.product.slogan) {
              document.getElementById('slogan').value = result.product.slogan;
              document.getElementById('sloganPreview').style.display = 'block';
            }

            showMessage('✨ Product saved successfully to Excel & JSON!', 'success');
            
            // Show the "Add Another" button and change save button text
            const addAnotherBtn = document.getElementById('addAnotherBtn');
            if (addAnotherBtn) addAnotherBtn.style.display = 'flex';
            submitBtn.querySelector('.btn-text').textContent = 'Product Saved!';
            submitBtn.classList.remove('loading');

            // Render submitted summary with all entered & generated data
            renderSubmittedSummary(result.product, payload);
          } else {
            if (response.status === 409) {
              partNoDuplicateExists = true;
              setPartNoStatus('This part number already exists.', 'error');
              updateSubmitAvailability();
              partNoInput?.focus();
            }
            showMessage(`Error: ${result.error || 'Unknown error'}`, 'error');
          }
        } catch (err) {
          showMessage(`Network error: ${err.message}`, 'error');
        } finally {
          submitBtn.classList.remove('loading');
        }
      });
      const isFeaturedCb = document.getElementById('is_featured');
      const featuredSettings = document.getElementById('featuredSettings');
      if (isFeaturedCb && featuredSettings) {
        isFeaturedCb.addEventListener('change', (e) => {
          featuredSettings.style.display = e.target.checked ? 'block' : 'none';
        });
      }

      // ============================================
      // Cloudinary Image Upload & Live Preview
      // ============================================
      const imagesInput = document.getElementById('images');
      const uploadImageBtn = document.getElementById('uploadImageBtn');
      const imageFileInput = document.getElementById('imageFileInput');
      const uploadFeedback = document.getElementById('uploadFeedback');
      const imagePreviewContainer = document.getElementById('imagePreviewContainer');
      const imageCountBadge = document.getElementById('imageCountBadge');
      const imageUploadGroup = document.getElementById('imageUploadGroup');

      function parseImageUrls(raw) {
        if (!raw) return [];
        return raw.split(',').map(s => s.trim()).filter(Boolean);
      }

      function setImageUrls(urls) {
        if (!imagesInput) return;
        imagesInput.value = urls.join(', ');
        imagesInput.dispatchEvent(new Event('input', { bubbles: true }));
        updateImagePreviews();
      }

      function showUploadFeedback(msg, type = 'info', autoHideMs = 4500) {
        if (!uploadFeedback) return;
        uploadFeedback.innerHTML = msg;
        uploadFeedback.className = `upload-feedback ${type}`;
        uploadFeedback.style.display = 'block';

        if (autoHideMs > 0) {
          clearTimeout(uploadFeedback._timer);
          uploadFeedback._timer = setTimeout(() => {
            uploadFeedback.style.display = 'none';
          }, autoHideMs);
        }
      }

      function updateImagePreviews() {
        if (!imagePreviewContainer || !imagesInput) return;
        const urls = parseImageUrls(imagesInput.value);

        if (imageCountBadge) {
          if (urls.length > 0) {
            imageCountBadge.textContent = `${urls.length} image${urls.length > 1 ? 's' : ''}`;
            imageCountBadge.style.display = 'inline-block';
          } else {
            imageCountBadge.style.display = 'none';
          }
        }

        if (urls.length === 0) {
          imagePreviewContainer.innerHTML = '';
          imagePreviewContainer.style.display = 'none';
          return;
        }

        imagePreviewContainer.style.display = 'grid';
        imagePreviewContainer.innerHTML = urls.map((url, index) => {
          const isMain = index === 0;
          return `
            <div class="preview-card ${isMain ? 'is-main' : ''}" data-index="${index}">
              <div class="preview-thumb-box">
                <img src="${url}" alt="Product preview ${index + 1}" class="preview-img" loading="lazy" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'100\\' height=\\'100\\' viewBox=\\'0 0 24 24\\' fill=\\'none\\' stroke=\\'%23ef4444\\' stroke-width=\\'2\\'><rect width=\\'18\\' height=\\'18\\' x=\\'3\\' y=\\'3\\' rx=\\'2\\'/><circle cx=\\'9\\' cy=\\'9\\' r=\\'2\\'/><path d=\\'m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21\\'/></svg>'; this.classList.add('img-error');">
                <span class="preview-badge ${isMain ? 'main-badge' : ''}">
                  ${isMain ? '★ Primary' : '#' + (index + 1)}
                </span>
                <div class="preview-overlay">
                  ${!isMain ? `<button type="button" class="preview-action-btn set-main-btn" data-action="set-main" data-index="${index}" title="Set as primary product image">★ Main</button>` : ''}
                  <a href="${url}" target="_blank" rel="noopener noreferrer" class="preview-action-btn view-btn" title="View full image">↗</a>
                  <button type="button" class="preview-action-btn remove-btn" data-action="remove" data-index="${index}" title="Remove this image">✕</button>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      // Preview actions delegation (set-main and remove)
      if (imagePreviewContainer) {
        imagePreviewContainer.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-action]');
          if (!btn) return;
          const action = btn.dataset.action;
          const index = parseInt(btn.dataset.index, 10);
          const urls = parseImageUrls(imagesInput.value);

          if (action === 'remove') {
            urls.splice(index, 1);
            setImageUrls(urls);
            showUploadFeedback('Image removed from list.', 'info', 2500);
          } else if (action === 'set-main') {
            const [selected] = urls.splice(index, 1);
            urls.unshift(selected);
            setImageUrls(urls);
            showUploadFeedback('Set as primary product image!', 'success', 2500);
          }
        });
      }

      // Live updates when user types or pastes image URLs
      if (imagesInput) {
        imagesInput.addEventListener('input', () => {
          updateImagePreviews();
        });
        imagesInput.addEventListener('paste', () => {
          setTimeout(updateImagePreviews, 50);
        });
        // Initial render if field already has value
        updateImagePreviews();
      }

      // ============================================
      // BgRemove SDK integration
      // ============================================
      const bgRemoveToggle = document.getElementById('bgRemoveToggle');
      const bgRemoveProgress = document.getElementById('bgRemoveProgress');
      const bgRemoveProgressFill = document.getElementById('bgRemoveProgressFill');
      const bgRemoveProgressPct = document.getElementById('bgRemoveProgressPct');
      const bgRemoveProgressStatus = document.getElementById('bgRemoveProgressStatus');
      let bgRemovePreloaded = false;

      // Preload BgRemove model when toggle is first enabled
      if (bgRemoveToggle) {
        bgRemoveToggle.addEventListener('change', () => {
          if (bgRemoveToggle.checked && !bgRemovePreloaded) {
            bgRemovePreloaded = true;
            try {
              if (typeof BgRemove !== 'undefined' && BgRemove.preload) {
                BgRemove.preload();
                showUploadFeedback('✂️ Background removal model is loading in the background...', 'info', 3000);
              }
            } catch (e) {
              console.warn('BgRemove preload skipped:', e);
            }
          }
        });
      }

      function showBgRemoveProgress(show) {
        if (bgRemoveProgress) bgRemoveProgress.style.display = show ? 'block' : 'none';
        if (!show) {
          updateBgRemoveProgress(0, 'Preparing model...');
        }
      }

      function updateBgRemoveProgress(pct, statusText) {
        const percent = Math.min(Math.round(pct * 100), 100);
        if (bgRemoveProgressFill) bgRemoveProgressFill.style.width = `${percent}%`;
        if (bgRemoveProgressPct) bgRemoveProgressPct.textContent = `${percent}%`;
        if (bgRemoveProgressStatus) bgRemoveProgressStatus.textContent = statusText || `Processing... ${percent}%`;
      }

      async function removeBackgroundFromFile(file, index, total) {
        return new Promise(async (resolve, reject) => {
          try {
            if (typeof BgRemove === 'undefined' || !BgRemove.removeBackground) {
              throw new Error('BgRemove SDK not loaded. Please wait and try again.');
            }

            updateBgRemoveProgress(0, `Removing background from image ${index + 1}/${total}...`);

            const resultBlob = await BgRemove.removeBackground(file, {
              maxDimension: 4096,
              onProgress: (p) => {
                updateBgRemoveProgress(p, `Removing background from image ${index + 1}/${total}... ${Math.round(p * 100)}%`);
              }
            });

            // Convert blob to File object for FormData
            const cleanName = file.name.replace(/\.[^.]+$/, '') + '_nobg.png';
            const resultFile = new File([resultBlob], cleanName, { type: 'image/png' });
            resolve(resultFile);
          } catch (err) {
            reject(err);
          }
        });
      }

      async function processFilesWithBgRemove(files) {
        const processed = [];
        showBgRemoveProgress(true);

        for (let i = 0; i < files.length; i++) {
          try {
            const result = await removeBackgroundFromFile(files[i], i, files.length);
            processed.push(result);
          } catch (err) {
            console.error(`BgRemove failed for ${files[i].name}:`, err);
            showUploadFeedback(
              `⚠️ Background removal failed for "${files[i].name}": ${err.message}. Uploading original instead.`,
              'warning',
              5000
            );
            processed.push(files[i]); // Fall back to original file
          }
        }

        showBgRemoveProgress(false);
        return processed;
      }

      async function handleFilesUpload(files) {
        if (!files || files.length === 0) return;

        const spinner = uploadImageBtn?.querySelector('.upload-spinner');
        const btnText = uploadImageBtn?.querySelector('.upload-btn-text');
        const btnIcon = uploadImageBtn?.querySelector('.upload-btn-icon');

        if (uploadImageBtn) {
          uploadImageBtn.disabled = true;
          uploadImageBtn.classList.add('uploading');
        }
        if (spinner) spinner.style.display = 'block';
        if (btnIcon) btnIcon.style.display = 'none';

        // If BgRemove toggle is ON, process files first
        let filesToUpload = files;
        if (bgRemoveToggle?.checked) {
          if (btnText) btnText.textContent = 'Removing BG...';
          showUploadFeedback(
            `<span class="uploading-icon">✂️</span> Removing background from ${files.length} image${files.length > 1 ? 's' : ''}...`,
            'uploading',
            0
          );

          try {
            filesToUpload = await processFilesWithBgRemove(files);
          } catch (err) {
            console.error('BgRemove batch error:', err);
            showUploadFeedback(
              `⚠️ Background removal encountered an error. Uploading originals instead.`,
              'warning',
              5000
            );
            filesToUpload = files; // Fallback to originals
          }
        }

        if (btnText) btnText.textContent = filesToUpload.length > 1 ? `Uploading (${filesToUpload.length})...` : 'Uploading...';

        showUploadFeedback(
          `<span class="uploading-icon">⏳</span> Uploading ${filesToUpload.length} image${filesToUpload.length > 1 ? 's' : ''} to Cloudinary...`,
          'uploading',
          0
        );

        try {
          const formData = new FormData();
          filesToUpload.forEach(file => {
            formData.append('files', file);
          });

          const response = await fetch('/api/upload-image', {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();

          if (!response.ok || !result.success) {
            throw new Error(result.error || 'Failed to upload image(s)');
          }

          // Merge newly uploaded URLs with any existing URLs
          const currentUrls = parseImageUrls(imagesInput.value);
          const newUrls = result.urls || [result.url];
          const combined = [...currentUrls, ...newUrls];
          setImageUrls(combined);

          const bgNote = bgRemoveToggle?.checked ? ' (background removed)' : '';
          showUploadFeedback(
            `✓ Successfully uploaded ${newUrls.length} image${newUrls.length > 1 ? 's' : ''}${bgNote} to Cloudinary! Preview updated.`,
            'success',
            4500
          );
        } catch (err) {
          console.error('Upload failed:', err);
          showUploadFeedback(
            `✕ Upload error: ${err.message || 'Could not upload image.'}`,
            'error',
            6000
          );
        } finally {
          if (uploadImageBtn) {
            uploadImageBtn.disabled = false;
            uploadImageBtn.classList.remove('uploading');
          }
          if (spinner) spinner.style.display = 'none';
          if (btnIcon) btnIcon.style.display = 'inline-block';
          if (btnText) btnText.textContent = 'Upload Image';
        }
      }

      // Button click triggers file chooser
      if (uploadImageBtn && imageFileInput) {
        uploadImageBtn.addEventListener('click', () => {
          imageFileInput.click();
        });

        imageFileInput.addEventListener('change', async () => {
          const files = Array.from(imageFileInput.files || []);
          if (files.length === 0) return;
          await handleFilesUpload(files);
          imageFileInput.value = '';
        });
      }

      // Drag and drop image files onto image upload container
      if (imageUploadGroup) {
        ['dragenter', 'dragover'].forEach(eventName => {
          imageUploadGroup.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            imageUploadGroup.classList.add('drag-over');
          });
        });

        ['dragleave', 'drop'].forEach(eventName => {
          imageUploadGroup.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            imageUploadGroup.classList.remove('drag-over');
          });
        });

        imageUploadGroup.addEventListener('drop', async (e) => {
          const dt = e.dataTransfer;
          const files = Array.from(dt?.files || []).filter(f => f.type.startsWith('image/'));
          if (files.length > 0) {
            await handleFilesUpload(files);
          }
        });
      }

      // ============================================
      // Cloudinary Video Upload & Live Preview
      // ============================================
      const videoUrlInput = document.getElementById('video_url');
      const uploadVideoBtn = document.getElementById('uploadVideoBtn');
      const videoFileInput = document.getElementById('videoFileInput');
      const videoUploadFeedback = document.getElementById('videoUploadFeedback');
      const videoPreviewContainer = document.getElementById('videoPreviewContainer');
      const videoStatusBadge = document.getElementById('videoStatusBadge');
      const videoUploadGroup = document.getElementById('videoUploadGroup');

      function showVideoFeedback(msg, type = 'info', autoHideMs = 4500) {
        if (!videoUploadFeedback) return;
        videoUploadFeedback.innerHTML = msg;
        videoUploadFeedback.className = `upload-feedback ${type}`;
        videoUploadFeedback.style.display = 'block';

        if (autoHideMs > 0) {
          clearTimeout(videoUploadFeedback._timer);
          videoUploadFeedback._timer = setTimeout(() => {
            videoUploadFeedback.style.display = 'none';
          }, autoHideMs);
        }
      }

      function updateVideoPreview() {
        if (!videoPreviewContainer || !videoUrlInput) return;
        const url = videoUrlInput.value.trim();

        if (!url) {
          videoPreviewContainer.innerHTML = '';
          videoPreviewContainer.style.display = 'none';
          if (videoStatusBadge) videoStatusBadge.style.display = 'none';
          return;
        }

        if (videoStatusBadge) {
          videoStatusBadge.style.display = 'inline-block';
        }

        videoPreviewContainer.style.display = 'block';
        videoPreviewContainer.innerHTML = `
          <div class="video-player-wrapper">
            <video src="${url}" controls playsinline preload="metadata" class="preview-video-element" onerror="this.parentElement.innerHTML='<div class=\\'video-error\\'>⚠️ Unable to load video preview. Please verify URL.</div>'"></video>
          </div>
          <div class="video-info-row">
            <div class="video-meta">
              <span class="video-badge">🎥 Featured Video</span>
              <span class="video-meta-detail">Banner Media</span>
            </div>
            <div class="video-actions">
              <a href="${url}" target="_blank" rel="noopener noreferrer" class="preview-action-btn view-btn" title="View video in new tab">↗ Open</a>
              <button type="button" class="preview-action-btn remove-btn" id="removeVideoBtn" title="Remove video">✕ Remove</button>
            </div>
          </div>
        `;

        const removeBtn = videoPreviewContainer.querySelector('#removeVideoBtn');
        if (removeBtn) {
          removeBtn.addEventListener('click', () => {
            videoUrlInput.value = '';
            videoUrlInput.dispatchEvent(new Event('input', { bubbles: true }));
            updateVideoPreview();
            showVideoFeedback('Video removed from form.', 'info', 2500);
          });
        }
      }

      if (videoUrlInput) {
        videoUrlInput.addEventListener('input', () => {
          updateVideoPreview();
        });
        videoUrlInput.addEventListener('paste', () => {
          setTimeout(updateVideoPreview, 50);
        });
        updateVideoPreview();
      }

      async function handleVideoUpload(file) {
        if (!file) return;

        if (!file.type.startsWith('video/')) {
          showVideoFeedback('Please select a valid video file (MP4, WebM, MOV, etc.).', 'error', 5000);
          return;
        }

        const spinner = uploadVideoBtn?.querySelector('.upload-vid-spinner');
        const btnText = uploadVideoBtn?.querySelector('.upload-vid-text');
        const btnIcon = uploadVideoBtn?.querySelector('.upload-vid-icon');

        if (uploadVideoBtn) {
          uploadVideoBtn.disabled = true;
          uploadVideoBtn.classList.add('uploading');
        }
        if (spinner) spinner.style.display = 'block';
        if (btnIcon) btnIcon.style.display = 'none';
        if (btnText) btnText.textContent = 'Uploading Video...';

        const fileSizeMB = (file.size / (1024 * 1024)).toFixed(1);
        showVideoFeedback(
          `<span class="uploading-icon">⏳</span> Uploading video (${fileSizeMB} MB) to Cloudinary... Please wait.`,
          'uploading',
          0
        );

        try {
          const formData = new FormData();
          formData.append('video', file);

          const response = await fetch('/api/upload-video', {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();

          if (!response.ok || !result.success) {
            throw new Error(result.error || 'Failed to upload video');
          }

          videoUrlInput.value = result.url;
          videoUrlInput.dispatchEvent(new Event('input', { bubbles: true }));
          updateVideoPreview();

          showVideoFeedback(
            `✓ Video successfully uploaded to Cloudinary! Preview loaded below.`,
            'success',
            5000
          );
        } catch (err) {
          console.error('Video upload failed:', err);
          showVideoFeedback(
            `✕ Video upload error: ${err.message || 'Could not upload video.'}`,
            'error',
            6500
          );
        } finally {
          if (uploadVideoBtn) {
            uploadVideoBtn.disabled = false;
            uploadVideoBtn.classList.remove('uploading');
          }
          if (spinner) spinner.style.display = 'none';
          if (btnIcon) btnIcon.style.display = 'inline-block';
          if (btnText) btnText.textContent = 'Upload Video';
        }
      }

      if (uploadVideoBtn && videoFileInput) {
        uploadVideoBtn.addEventListener('click', () => {
          videoFileInput.click();
        });

        videoFileInput.addEventListener('change', async () => {
          const file = videoFileInput.files?.[0];
          if (!file) return;
          await handleVideoUpload(file);
          videoFileInput.value = '';
        });
      }

      // Drag and drop video
      if (videoUploadGroup) {
        ['dragenter', 'dragover'].forEach(eventName => {
          videoUploadGroup.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            videoUploadGroup.classList.add('drag-over');
          });
        });

        ['dragleave', 'drop'].forEach(eventName => {
          videoUploadGroup.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            videoUploadGroup.classList.remove('drag-over');
          });
        });

        videoUploadGroup.addEventListener('drop', async (e) => {
          const dt = e.dataTransfer;
          const file = Array.from(dt?.files || []).find(f => f.type.startsWith('video/'));
          if (file) {
            await handleVideoUpload(file);
          }
        });
      }

      // Variants JS Logic
      const variantsContainer = document.getElementById('variantsContainer');
      const addVariantBtn = document.getElementById('addVariantBtn');

      function splitImageList(value) {
        return value.split(',').map(s => s.trim()).filter(Boolean);
      }

      function getMainProductDefaults() {
        const images = document.getElementById('images').value.trim();

        return {
          partNo: document.getElementById('part_no').value.trim(),
          price: document.getElementById('mrp').value.trim(),
          images,
          imageList: splitImageList(images),
        };
      }

      function getVariantsData() {
        const variantRows = variantsContainer.querySelectorAll('.variant-row');
        const defaults = getMainProductDefaults();
        const variants = [];
        variantRows.forEach(row => {
          const priceValue = row.querySelector('.v-price').value.trim() || defaults.price;
          const imagesValue = row.querySelector('.v-images').value.trim() || defaults.images;

          variants.push({
            variant_id: row.querySelector('.v-id').value.trim(),
            price: priceValue ? parseFloat(priceValue) : '',
            part_no: row.querySelector('.v-partno').value.trim() || defaults.partNo,
            sku: row.querySelector('.v-sku').value,
            images: imagesValue ? splitImageList(imagesValue) : defaults.imageList,
          });
        });
        return variants;
      }

      if (addVariantBtn) {
        addVariantBtn.addEventListener('click', () => {
          const defaults = getMainProductDefaults();
          const row = document.createElement('div');
          row.className = 'variant-row';
          row.innerHTML = `
            <div class="v-group">
              <label>Variant ID (e.g. 6A) <span class="required">*</span></label>
              <input type="text" class="v-id" required>
            </div>
            <div class="v-group">
              <label>Price (₹) <span class="required">*</span></label>
              <input type="number" step="0.01" class="v-price" required>
            </div>
            <div class="v-group">
              <label>Part No</label>
              <input type="text" class="v-partno">
            </div>
            <div class="v-group">
              <label>SKU</label>
              <input type="text" class="v-sku">
            </div>
            <div class="v-group v-span-full">
              <label>Images (comma separated)</label>
              <input type="text" class="v-images">
            </div>
            <button type="button" class="remove-variant-btn">✕</button>
          `;
          row.querySelector('.v-price').value = defaults.price;
          row.querySelector('.v-partno').value = defaults.partNo;
          row.querySelector('.v-images').value = defaults.images;
          row.querySelector('.remove-variant-btn').addEventListener('click', () => row.remove());
          variantsContainer.appendChild(row);
        });
      }

      // Add New Product preserving category logic
      function resetFormForNewProductSameCategory() {
        // Clear unique/product-specific fields while preserving category & subcategory selections
        [
          'part_no', 'product_name', 'type', 'images', 'video_url', 
          'custom_features', 'variant_name', 'mrp', 'unit', 
          'featured_link', 'featured_button_text', 
          'description', 'key_features', 'meta_title', 'meta_description', 'slug', 'slogan'
        ].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.value = '';
        });
        resetPartNoCheck();
        
        const variantsContainer = document.getElementById('variantsContainer');
        if (variantsContainer) variantsContainer.innerHTML = '';
        
        const sloganPreview = document.getElementById('sloganPreview');
        if (sloganPreview) sloganPreview.style.display = 'none';
        
        const isFeatured = document.getElementById('is_featured');
        if (isFeatured) isFeatured.checked = false;
        
        const featuredSettings = document.getElementById('featuredSettings');
        if (featuredSettings) featuredSettings.style.display = 'none';
        
        // Clear image previews & badges
        if (imagePreviewContainer) {
          imagePreviewContainer.innerHTML = '';
          imagePreviewContainer.style.display = 'none';
        }
        if (imageCountBadge) imageCountBadge.style.display = 'none';
        if (uploadFeedback) uploadFeedback.style.display = 'none';

        // Clear video preview & badges
        if (videoPreviewContainer) {
          videoPreviewContainer.innerHTML = '';
          videoPreviewContainer.style.display = 'none';
        }
        if (videoStatusBadge) videoStatusBadge.style.display = 'none';
        if (videoUploadFeedback) videoUploadFeedback.style.display = 'none';

        // Hide summary card
        const summaryCard = document.getElementById('submittedProductSummary');
        if (summaryCard) summaryCard.style.display = 'none';

        // Reset submit button & messages
        const addAnotherBtn = document.getElementById('addAnotherBtn');
        if (addAnotherBtn) addAnotherBtn.style.display = 'none';
        
        submitBtn.querySelector('.btn-text').textContent = 'Generate AI & Save Product';
        submitBtn.disabled = false;
        submitBtn.classList.remove('loading');
        messageDiv.style.display = 'none';

        const cat = catSelect?.value;
        const subcat = subcatSelect?.value;
        if (cat) {
          showMessage(`Category preserved: ${cat.replace(/_/g, ' ')}${subcat ? ' > ' + subcat.replace(/_/g, ' ') : ''}. Ready for next product!`, 'info');
        }

        // Scroll to top of the form area and focus part_no
        window.scrollTo({ top: 0, behavior: 'smooth' });
        setTimeout(() => {
          const partNoEl = document.getElementById('part_no');
          if (partNoEl) partNoEl.focus();
        }, 150);
      }

      function renderSubmittedSummary(product, payload) {
        const summaryCard = document.getElementById('submittedProductSummary');
        if (!summaryCard) return;

        // Populate basic fields
        document.getElementById('sum_part_no').textContent = product.part_no || payload.part_no || '—';
        document.getElementById('sum_product_name').textContent = product.product_name || payload.product_name || '—';
        document.getElementById('sum_brand').textContent = product.brand || payload.brand || '—';
        
        const mrpVal = product.mrp || payload.mrp;
        const parsedMrp = Number(mrpVal);
        document.getElementById('sum_mrp').textContent = !isNaN(parsedMrp) ? `₹ ${parsedMrp.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : (mrpVal || '—');
        document.getElementById('sum_unit').textContent = product.unit || payload.unit || '—';
        document.getElementById('sum_type').textContent = product.type || payload.type || '—';
        document.getElementById('sum_variant_name').textContent = product.variant_name || payload.variant_name || '—';

        // Category path
        const cat = (product.category || payload.category || '').replace(/_/g, ' ');
        const subcat = (product.subcategory || payload.subcategory || '').replace(/_/g, ' ');
        const subsub = (product.subsubcategory || payload.subsubcategory || '').replace(/_/g, ' ');
        document.getElementById('sum_category_path').innerHTML = `
          <span class="crumb">${cat}</span>
          ${subcat ? `<span class="crumb-sep">›</span><span class="crumb">${subcat}</span>` : ''}
          ${subsub ? `<span class="crumb-sep">›</span><span class="crumb subsub-crumb">${subsub}</span>` : ''}
        `;

        // Custom features
        const customFeatures = product.custom_features || payload.custom_features;
        const specsRow = document.getElementById('sum_specs_row');
        if (customFeatures) {
          document.getElementById('sum_custom_features').textContent = customFeatures;
          specsRow.style.display = 'flex';
        } else {
          specsRow.style.display = 'none';
        }

        // Media
        const imagesRaw = product.images || payload.images || '';
        const imgList = (typeof imagesRaw === 'string' ? imagesRaw.split(',') : (Array.isArray(imagesRaw) ? imagesRaw : [])).map(s => String(s).trim()).filter(Boolean);
        const mediaSection = document.getElementById('sum_media_section');
        const imgGallery = document.getElementById('sum_images_preview');
        
        if (imgList.length > 0) {
          mediaSection.style.display = 'block';
          imgGallery.innerHTML = imgList.map((img, idx) => `
            <a href="${img}" target="_blank" rel="noopener noreferrer" class="summary-img-thumb" title="Click to view full image">
              <img src="${img}" alt="Product image ${idx + 1}" loading="lazy" onerror="this.parentElement.style.display='none'">
              <span class="img-badge">#${idx + 1}</span>
            </a>
          `).join('');
        } else {
          imgGallery.innerHTML = '';
          mediaSection.style.display = 'none';
        }

        const videoUrl = product.video_url || payload.video_url;
        const videoRow = document.getElementById('sum_video_row');
        if (videoUrl) {
          mediaSection.style.display = 'block';
          videoRow.style.display = 'flex';
          document.getElementById('sum_video_url').innerHTML = `<a href="${videoUrl}" target="_blank" class="val-link">${videoUrl} ↗</a>`;
        } else {
          videoRow.style.display = 'none';
        }

        // Variants
        let variants = [];
        if (product.variants) {
          try {
            variants = typeof product.variants === 'string' ? JSON.parse(product.variants) : product.variants;
          } catch(e) {
            variants = payload.variants || [];
          }
        } else if (payload.variants) {
          variants = payload.variants;
        }

        const variantsSection = document.getElementById('sum_variants_section');
        if (variants && variants.length > 0) {
          variantsSection.style.display = 'block';
          document.getElementById('sum_variants_count').textContent = variants.length;
          const variantsList = document.getElementById('sum_variants_list');
          variantsList.innerHTML = variants.map(v => `
            <div class="summary-variant-pill">
              <strong>${v.variant_id}</strong>
              <span>₹${v.price || product.mrp || payload.mrp}</span>
              ${v.part_no ? `<span class="var-part">Part: ${v.part_no}</span>` : ''}
              ${v.sku ? `<span class="var-sku">SKU: ${v.sku}</span>` : ''}
            </div>
          `).join('');
        } else {
          variantsSection.style.display = 'none';
        }

        // AI Generated Content
        document.getElementById('sum_description').textContent = product.description || '—';
        
        let keyFeatures = [];
        if (product.key_features) {
          try {
            keyFeatures = typeof product.key_features === 'string' ? JSON.parse(product.key_features) : product.key_features;
          } catch(e) {
            keyFeatures = String(product.key_features).split('\n').filter(Boolean);
          }
        }
        const specsList = document.getElementById('sum_key_features');
        if (keyFeatures && keyFeatures.length > 0) {
          specsList.innerHTML = keyFeatures.map(item => `<li>${String(item).replace(/^-\s*/, '')}</li>`).join('');
        } else {
          specsList.innerHTML = '<li>None generated</li>';
        }

        document.getElementById('sum_meta_title').textContent = product.meta_title || '—';
        document.getElementById('sum_meta_description').textContent = product.meta_description || '—';
        document.getElementById('sum_slug').textContent = product.slug || '—';

        const sloganRow = document.getElementById('sum_slogan_row');
        if (product.slogan) {
          sloganRow.style.display = 'flex';
          document.getElementById('sum_slogan').textContent = product.slogan;
        } else {
          sloganRow.style.display = 'none';
        }

        // Action links
        const partNo = encodeURIComponent(product.part_no || payload.part_no);
        const liveSlug = encodeURIComponent(product.slug || product.part_no || payload.part_no);

        const editHref = `/admin/edit-product?id=${partNo}`;
        document.getElementById('summaryEditBtn').setAttribute('href', editHref);
        document.getElementById('summaryEditBtnBottom').setAttribute('href', editHref);

        const liveHref = `/product/${liveSlug}`;
        document.getElementById('summaryLiveBtn').setAttribute('href', liveHref);

        // Show summary card and scroll smoothly
        summaryCard.style.display = 'block';
        setTimeout(() => {
          summaryCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }

      // Wire up buttons
      document.getElementById('topAddProductBtn')?.addEventListener('click', resetFormForNewProductSameCategory);
      document.getElementById('addAnotherBtn')?.addEventListener('click', resetFormForNewProductSameCategory);
      document.getElementById('summaryAddAnotherBtn')?.addEventListener('click', resetFormForNewProductSameCategory);
      document.getElementById('summaryAddAnotherBtnBottom')?.addEventListener('click', resetFormForNewProductSameCategory);
    });
  </script>
</AdminLayout>

