---
import AdminLayout from '../../components/AdminLayout.astro';
---

<AdminLayout title="Manage Brands | Admin">
  <div class="admin-wrapper">
    <div class="glass-container">
      <header class="admin-header">
        <div class="title-wrapper">
          <div class="icon-box">🏷️</div>
          <h1>Manage Brands</h1>
        </div>
        <p class="subtitle">Add, edit, and manage product brands</p>
      </header>

      <div id="main-content" style="display: block;">
        <div class="actions-bar" style="justify-content: space-between; align-items: center; gap: 1rem;">
          <div class="search-box" style="flex: 1; max-width: 400px; position: relative;">
            <input type="text" id="brand-search" placeholder="Search brands by name or category..." style="padding-left: 2.5rem;">
            <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); opacity: 0.5;">🔍</span>
          </div>
          <button id="add-brand-btn" class="submit-btn" style="width: auto; padding: 0.8rem 1.5rem;">
            <span class="btn-text">+ Add New Brand</span>
          </button>
        </div>

        <div id="brands-container" class="brands-grid">
          <!-- Brands injected via JS -->
          <div class="loading-state">Loading brands...</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add/Edit Modal — placed OUTSIDE glass-container so fixed positioning works -->
  <div id="brand-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content glass-panel">
      <div class="modal-header">
        <h2 id="modal-title">Add Brand</h2>
        <button id="close-modal" class="close-btn">✕</button>
      </div>
      <form id="brand-form" class="product-form">
        <input type="hidden" id="original_name" value="">
        <div class="input-group">
          <label>Brand Name <span class="required">*</span></label>
          <input type="text" id="brand_name" required>
        </div>
        <div class="input-group">
          <label>Category <span class="optional">(e.g. Electrical, Plumbing)</span></label>
          <select id="brand_category" required><option disabled selected>Loading categories…</option></select>
        </div>
        <div class="input-group">
          <label>Logo Image URL</label>
          <div style="display: flex; gap: 0.5rem; align-items: center;">
            <input type="text" id="brand_image_url" style="flex: 1;" placeholder="URL auto-filled after upload">
            <input type="file" id="brand_image_file" accept="image/*" style="display:none;">
            <button type="button" id="upload_widget" class="button variant-add-btn" style="white-space:nowrap;">
              <span id="upload_widget_text">📤 Upload Image</span>
            </button>
          </div>

          <!-- Background Removal Toggle -->
          <div class="bgremove-toggle-row" id="brandBgRemoveToggleRow" style="margin-top: 0.75rem;">
            <label class="bgremove-toggle-label" for="brandBgRemoveToggle">
              <input type="checkbox" id="brandBgRemoveToggle">
              <span class="bgremove-switch"></span>
              <span class="bgremove-label-text">
                <span class="bgremove-icon">✂️</span> Remove Background
              </span>
              <span class="bgremove-hint">(auto-removes before upload)</span>
            </label>
          </div>

          <!-- BgRemove Progress -->
          <div id="brandBgRemoveProgress" class="bgremove-progress" style="display: none;">
            <div class="bgremove-progress-header">
              <span class="bgremove-progress-icon">✂️</span>
              <span class="bgremove-progress-label">Removing background...</span>
              <span class="bgremove-progress-pct" id="brandBgRemoveProgressPct">0%</span>
            </div>
            <div class="bgremove-progress-bar">
              <div class="bgremove-progress-fill" id="brandBgRemoveProgressFill"></div>
            </div>
            <p class="bgremove-progress-status" id="brandBgRemoveProgressStatus">Preparing model...</p>
          </div>

          <!-- Preview & Action Box -->
          <div id="brand_img_preview" style="margin-top:0.75rem; display:none;">
            <div class="brand-preview-box">
              <img id="brand_img_thumb" src="" alt="Brand logo preview">
              <div class="brand-preview-actions">
                <button type="button" id="brandRemoveBgBtn" class="preview-action-btn bg-remove-btn" title="Remove background from this logo">
                  ✂️ Remove BG
                </button>
                <a id="brandViewImgBtn" href="#" target="_blank" rel="noopener noreferrer" class="preview-action-btn view-btn" title="View full image">
                  ↗ View
                </a>
              </div>
            </div>
          </div>
        </div>
        <div class="form-footer" style="margin-top: 1.5rem;">
          <button type="submit" class="submit-btn"><span class="btn-text">Save Brand</span></button>
        </div>
      </form>
    </div>
  </div>

  <!-- Delete Confirmation Modal — placed OUTSIDE glass-container so fixed positioning works -->
  <div id="delete-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content glass-panel">
      <div class="modal-header">
        <h2>Confirm Deletion</h2>
        <button id="close-delete-modal" class="close-btn">✕</button>
      </div>
      <div id="delete-warning" style="margin-top: 1rem;"></div>
      <div id="reassign-section" style="display: none; margin-top: 1rem;">
        <div class="input-group">
          <label>Reassign dependent products to:</label>
          <select id="reassign_brand"></select>
        </div>
      </div>
      <div class="form-footer" style="margin-top: 1.5rem; flex-direction: row; gap: 1rem;">
        <button id="confirm-delete-btn" class="submit-btn" style="background: var(--error);"><span class="btn-text">Delete</span></button>
        <button id="cancel-delete-btn" class="submit-btn" style="background: rgba(255,255,255,0.1); color: white;"><span class="btn-text">Cancel</span></button>
      </div>
    </div>
  </div>

  <!-- BgRemove SDK -->
  <script src="https://bgremovers.org/sdk/v1.js" defer></script>

  <style is:global>
    :root {
      --bg-color: #0d0f14;
      --glass-bg: rgba(22, 26, 35, 0.6);
      --glass-border: rgba(255, 255, 255, 0.08);
      --text-primary: #f3f4f6;
      --text-secondary: #9ca3af;
      --accent: #c5a028;
      --accent-glow: rgba(197, 160, 40, 0.4);
      --error: #ef4444;
      --success: #10b981;
      --input-bg: rgba(15, 17, 23, 0.8);
    }
    body {
      background-color: var(--bg-color);
      color: var(--text-primary);
      font-family: 'Inter', -apple-system, sans-serif;
    }
    .admin-wrapper { width: 100%; margin: 0 auto; }
    .glass-container {
      width: 100%; max-width: 1000px;
      background: var(--glass-bg); backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border); border-radius: 24px;
      padding: 3rem; margin: 0 auto;
    }
    .admin-header { text-align: center; margin-bottom: 2rem; }
    .title-wrapper { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 0.5rem; }
    .icon-box {
      width: 40px; height: 40px;
      background: linear-gradient(135deg, var(--accent), #eab308);
      border-radius: 12px; display: flex; align-items: center; justify-content: center;
      color: #000; font-size: 1.5rem; font-weight: bold;
    }
    h1 { font-size: 2rem; margin: 0; }
    .subtitle { color: var(--text-secondary); margin: 0; }
    
    .actions-bar { display: flex; justify-content: flex-end; margin-bottom: 2rem; }
    
    .brands-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem;
    }
    .brand-card {
      background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border);
      border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;
      transition: all 0.2s ease;
    }
    .brand-card:hover { border-color: var(--accent); transform: translateY(-2px); }
    .brand-header { display: flex; align-items: center; gap: 1rem; }
    .brand-logo { width: 50px; height: 50px; border-radius: 8px; object-fit: contain; background: white; padding: 4px; }
    .brand-info h3 { margin: 0; font-size: 1.1rem; }
    .brand-info p { margin: 0; font-size: 0.8rem; color: var(--text-secondary); }
    .brand-actions { display: flex; gap: 0.5rem; margin-top: auto; }
    .brand-actions button { flex: 1; padding: 0.5rem; border-radius: 6px; cursor: pointer; font-weight: 500; border: none; }
    .btn-edit { background: rgba(197, 160, 40, 0.2); color: var(--accent); }
    .btn-edit:hover { background: var(--accent); color: black; }
    .btn-delete { background: rgba(239, 68, 68, 0.2); color: var(--error); }
    .btn-delete:hover { background: var(--error); color: white; }

    .modal-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.7); backdrop-filter: blur(5px);
      display: flex; align-items: center; justify-content: center; z-index: 100;
    }
    .modal-content {
      width: 100%; max-width: 500px; padding: 2rem;
      background: #161a23; border: 1px solid var(--glass-border); border-radius: 16px;
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .modal-header h2 { margin: 0; font-size: 1.5rem; }
    .close-btn { background: none; border: none; color: var(--text-secondary); font-size: 1.5rem; cursor: pointer; }
    .close-btn:hover { color: white; }

    input, select {
      width: 100%; background: var(--input-bg); border: 1px solid var(--glass-border);
      border-radius: 8px; padding: 0.75rem; color: var(--text-primary); font-family: inherit;
    }
    input:focus, select:focus { outline: none; border-color: var(--accent); }
    .input-group { margin-bottom: 1rem; }
    .input-group label { display: block; margin-bottom: 0.5rem; font-size: 0.9rem; color: #d1d5db; }
    
    .submit-btn {
      width: 100%; padding: 0.875rem; background: linear-gradient(135deg, var(--accent), #d4af37);
      color: #000; border: none; border-radius: 12px; font-weight: 600; cursor: pointer;
      transition: all 0.3s;
    }
    .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 20px var(--accent-glow); }

    .auth-gate { text-align: center; max-width: 400px; margin: 0 auto; padding: 2rem 0; }

    /* BgRemove Toggle Row */
    .bgremove-toggle-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .bgremove-toggle-label {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      cursor: pointer;
      user-select: none;
      font-size: 0.85rem;
      color: var(--text-secondary);
      transition: color 0.2s ease;
    }

    .bgremove-toggle-label:hover {
      color: var(--text-primary);
    }

    .bgremove-toggle-label input[type="checkbox"] {
      display: none;
    }

    .bgremove-switch {
      position: relative;
      width: 36px;
      height: 20px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      transition: all 0.3s ease;
      flex-shrink: 0;
    }

    .bgremove-switch::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 2px;
      width: 14px;
      height: 14px;
      background: var(--text-secondary);
      border-radius: 50%;
      transition: all 0.3s ease;
    }

    .bgremove-toggle-label input:checked + .bgremove-switch {
      background: rgba(139, 92, 246, 0.5);
      border-color: rgba(139, 92, 246, 0.6);
    }

    .bgremove-toggle-label input:checked + .bgremove-switch::after {
      left: 18px;
      background: #a78bfa;
      box-shadow: 0 0 6px rgba(139, 92, 246, 0.5);
    }

    .bgremove-label-text {
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    .bgremove-icon {
      font-size: 1rem;
    }

    .bgremove-hint {
      font-size: 0.75rem;
      color: var(--text-secondary);
      opacity: 0.7;
    }

    /* BgRemove Progress */
    .bgremove-progress {
      margin-top: 0.6rem;
      padding: 0.8rem 1rem;
      background: rgba(139, 92, 246, 0.08);
      border: 1px solid rgba(139, 92, 246, 0.2);
      border-radius: 10px;
      animation: bgremovePulse 2s ease-in-out infinite;
    }

    @keyframes bgremovePulse {
      0%, 100% { border-color: rgba(139, 92, 246, 0.2); }
      50% { border-color: rgba(139, 92, 246, 0.45); }
    }

    .bgremove-progress-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }

    .bgremove-progress-icon {
      font-size: 1rem;
      animation: scissorSnip 0.8s ease-in-out infinite alternate;
    }

    @keyframes scissorSnip {
      0% { transform: rotate(-5deg) scale(1); }
      100% { transform: rotate(5deg) scale(1.1); }
    }

    .bgremove-progress-label {
      font-size: 0.82rem;
      font-weight: 600;
      color: #c4b5fd;
      flex: 1;
    }

    .bgremove-progress-pct {
      font-size: 0.82rem;
      font-weight: 700;
      color: #a78bfa;
      font-variant-numeric: tabular-nums;
    }

    .bgremove-progress-bar {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 3px;
      overflow: hidden;
    }

    .bgremove-progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #8b5cf6, #a78bfa, #c4b5fd);
      border-radius: 3px;
      transition: width 0.3s ease;
      box-shadow: 0 0 8px rgba(139, 92, 246, 0.4);
    }

    .bgremove-progress-status {
      margin: 0.4rem 0 0;
      font-size: 0.75rem;
      color: var(--text-secondary);
      opacity: 0.8;
    }

    /* Brand Preview Box */
    .brand-preview-box {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--glass-border);
      border-radius: 10px;
    }

    .brand-preview-box img {
      max-height: 70px;
      max-width: 90px;
      object-fit: contain;
      border-radius: 6px;
      background: #ffffff;
      padding: 4px;
    }

    .brand-preview-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .preview-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.4rem 0.75rem;
      font-size: 0.8rem;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s ease;
      border: 1px solid transparent;
    }

    .bg-remove-btn {
      background: rgba(139, 92, 246, 0.2);
      color: #c4b5fd;
      border-color: rgba(139, 92, 246, 0.3);
    }

    .bg-remove-btn:hover:not(:disabled) {
      background: rgba(139, 92, 246, 0.4);
      color: #ffffff;
      border-color: rgba(139, 92, 246, 0.6);
    }

    .bg-remove-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .view-btn {
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-primary);
      border-color: var(--glass-border);
    }

    .view-btn:hover {
      background: rgba(255, 255, 255, 0.12);
      color: white;
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let brands = [];
      
      init();

      function init() {
        fetchBrands();
        fetchCategories();
        
        // Setup search
        const searchInput = document.getElementById('brand-search');
        searchInput.addEventListener('input', (e) => {
          renderBrands(e.target.value.toLowerCase());
        });
      }

      async function fetchBrands() {
        const container = document.getElementById('brands-container');
        container.innerHTML = '<div class="loading-state">Loading brands...</div>';
        try {
          const res = await fetch('/api/get-brands', { cache: 'no-store' });
          if (res.ok) {
            brands = await res.json();
            renderBrands();
          } else {
            container.innerHTML = `<div class="error">Failed to load brands</div>`;
          }
        } catch (e) {
          container.innerHTML = `<div class="error">${e.message}</div>`;
        }
      }

      let categoriesList = [];

      // ── Category dropdown ────────────────────────────────────────────────
      async function fetchCategories() {
        const sel = document.getElementById('brand_category');
        try {
          const res = await fetch('/api/get-categories', { cache: 'no-store' });
          if (!res.ok) throw new Error('Failed to fetch categories');
          const data = await res.json();
          // Top-level categories excluding 'Brands'
          const keys = Object.keys(data).filter(k => k !== 'Brands');
          categoriesList = keys.map(k => k.replace(/_/g, ' '));
          
          populateCategorySelect();
        } catch (err) {
          sel.innerHTML = '<option value="" disabled selected>Could not load categories</option>';
          console.error('Category fetch error:', err);
        }
      }

      function populateCategorySelect(selectedValue = '') {
        const sel = document.getElementById('brand_category');
        if (!sel) return;

        let options = '<option value="" disabled' + (!selectedValue ? ' selected' : '') + '>Select a category…</option>';
        
        categoriesList.forEach(cat => {
          const isSelected = selectedValue && selectedValue.toLowerCase() === cat.toLowerCase();
          options += `<option value="${cat}"${isSelected ? ' selected' : ''}>${cat}</option>`;
        });

        // If the brand has a category not present in the standard top-level list (e.g. legacy/combined), preserve it
        if (selectedValue && !categoriesList.some(c => c.toLowerCase() === selectedValue.toLowerCase())) {
          options += `<option value="${selectedValue}" selected>${selectedValue}</option>`;
        }

        sel.innerHTML = options;
        if (selectedValue) {
          sel.value = selectedValue;
        }
      }

      // ── Brand image upload via /api/upload-image ─────────────────────────
      let isBrandUploading = false;
      let isBrandRemovingBg = false;
      let bgRemovePreloaded = false;

      const brandBgRemoveToggle = document.getElementById('brandBgRemoveToggle');
      const brandBgRemoveProgress = document.getElementById('brandBgRemoveProgress');
      const brandBgRemoveProgressFill = document.getElementById('brandBgRemoveProgressFill');
      const brandBgRemoveProgressPct = document.getElementById('brandBgRemoveProgressPct');
      const brandBgRemoveProgressStatus = document.getElementById('brandBgRemoveProgressStatus');
      const brandRemoveBgBtn = document.getElementById('brandRemoveBgBtn');
      const brandViewImgBtn = document.getElementById('brandViewImgBtn');

      function updateBrandSubmitState() {
        const submitBtn = brandForm.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.disabled = isBrandUploading || isBrandRemovingBg;
        }
      }

      function showBrandBgRemoveProgress(show) {
        if (brandBgRemoveProgress) brandBgRemoveProgress.style.display = show ? 'block' : 'none';
        if (!show) {
          updateBrandBgRemoveProgress(0, 'Preparing model...');
        }
      }

      function extractProgressPct(p) {
        if (typeof p === 'number') return Math.min(Math.max(p, 0), 1);
        if (!p || typeof p !== 'object') return 0;
        if (typeof p.progress === 'number') return Math.min(Math.max(p.progress, 0), 1);
        if (p.progress && typeof p.progress.progress === 'number') return Math.min(Math.max(p.progress.progress, 0), 1);
        if (p.loaded && p.total) return Math.min(Math.max(p.loaded / p.total, 0), 1);
        if (p.stage === 'loading-runtime') return 0.1;
        if (p.stage === 'loading-model') return 0.25;
        if (p.stage === 'ready') return 0.6;
        return 0.3;
      }

      function extractStatusMessage(p, fallback) {
        if (!p) return fallback;
        if (typeof p === 'string') return p;
        if (typeof p === 'object') {
          if (p.stage === 'loading-runtime') return 'Loading AI runtime...';
          if (p.stage === 'loading-model') return 'Loading AI model...';
          if (p.stage === 'downloading') {
            const pct = Math.round(extractProgressPct(p) * 100);
            return `Downloading AI model... ${pct}%`;
          }
          if (p.stage === 'ready') return 'Processing image...';
        }
        return fallback;
      }

      function updateBrandBgRemoveProgress(pct, statusText) {
        const numeric = extractProgressPct(pct);
        const percent = Math.min(Math.round(numeric * 100), 100);
        if (brandBgRemoveProgressFill) brandBgRemoveProgressFill.style.width = `${percent}%`;
        if (brandBgRemoveProgressPct) brandBgRemoveProgressPct.textContent = `${percent}%`;
        if (brandBgRemoveProgressStatus) brandBgRemoveProgressStatus.textContent = statusText || `Processing... ${percent}%`;
      }

      // Preload BgRemove model when toggle is first enabled
      if (brandBgRemoveToggle) {
        brandBgRemoveToggle.addEventListener('change', () => {
          if (brandBgRemoveToggle.checked && !bgRemovePreloaded) {
            bgRemovePreloaded = true;
            try {
              if (typeof BgRemove !== 'undefined' && BgRemove.preload) {
                BgRemove.preload();
              }
            } catch (e) {
              console.warn('BgRemove preload skipped:', e);
            }
          }
        });
      }

      async function removeBackgroundFromFile(file) {
        if (typeof BgRemove === 'undefined' || !BgRemove.removeBackground) {
          throw new Error('BgRemove SDK not loaded yet. Please wait a moment and try again.');
        }

        updateBrandBgRemoveProgress(0, 'Removing background from logo...');

        const resultBlob = await BgRemove.removeBackground(file, {
          maxDimension: 4096,
          onProgress: (p) => {
            const prog = extractProgressPct(p);
            const status = extractStatusMessage(p, `Removing background... ${Math.round(prog * 100)}%`);
            updateBrandBgRemoveProgress(prog, status);
          }
        });

        const cleanName = (file.name ? file.name.replace(/\.[^.]+$/, '') : 'logo') + '_nobg.png';
        return new File([resultBlob], cleanName, { type: 'image/png' });
      }

      function updateBrandPreview(url) {
        const preview = document.getElementById('brand_img_preview');
        const thumb = document.getElementById('brand_img_thumb');
        if (url) {
          thumb.src = url;
          if (brandViewImgBtn) brandViewImgBtn.href = url;
          preview.style.display = 'block';
        } else {
          preview.style.display = 'none';
        }
      }

      document.getElementById('upload_widget').addEventListener('click', () => {
        document.getElementById('brand_image_file').click();
      });

      document.getElementById('brand_image_file').addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file || isBrandUploading || isBrandRemovingBg) return;

        isBrandUploading = true;
        updateBrandSubmitState();

        const btn = document.getElementById('upload_widget');
        const btnText = document.getElementById('upload_widget_text');
        btn.disabled = true;

        try {
          let fileToUpload = file;

          // Check if Auto-remove BG toggle is active
          if (brandBgRemoveToggle && brandBgRemoveToggle.checked) {
            btnText.textContent = '✂️ Removing BG…';
            showBrandBgRemoveProgress(true);
            try {
              fileToUpload = await removeBackgroundFromFile(file);
            } catch (bgErr) {
              console.error('Auto remove-bg failed:', bgErr);
              alert('⚠️ Background removal failed: ' + bgErr.message + '. Uploading original instead.');
              fileToUpload = file;
            } finally {
              showBrandBgRemoveProgress(false);
            }
          }

          btnText.textContent = '⏳ Uploading…';

          const formData = new FormData();
          formData.append('file', fileToUpload);
          const res = await fetch('/api/upload-image', { method: 'POST', body: formData });
          if (!res.ok) throw new Error('Upload failed');
          const data = await res.json();
          const url = data.url || data.secure_url || '';
          if (!url) throw new Error('No URL returned');
          document.getElementById('brand_image_url').value = url;
          updateBrandPreview(url);
          btnText.textContent = '✅ Uploaded';
        } catch (err) {
          alert('Image upload failed: ' + err.message);
          btnText.textContent = '📤 Upload Image';
        } finally {
          isBrandUploading = false;
          btn.disabled = false;
          updateBrandSubmitState();
          e.target.value = '';
        }
      });

      // Individual "✂️ Remove BG" button on existing preview image
      if (brandRemoveBgBtn) {
        brandRemoveBgBtn.addEventListener('click', async () => {
          const currentUrl = document.getElementById('brand_image_url').value.trim();
          if (!currentUrl) {
            alert('No image URL available to remove background.');
            return;
          }
          if (isBrandUploading || isBrandRemovingBg) {
            alert('Another upload or processing task is running. Please wait...');
            return;
          }

          isBrandRemovingBg = true;
          updateBrandSubmitState();
          brandRemoveBgBtn.disabled = true;
          const origBtnText = brandRemoveBgBtn.innerHTML;
          brandRemoveBgBtn.innerHTML = '⏳ Removing…';

          try {
            if (typeof BgRemove === 'undefined' || !BgRemove.removeBackground) {
              throw new Error('BgRemove SDK is loading. Please wait a few seconds and try again.');
            }

            showBrandBgRemoveProgress(true);
            updateBrandBgRemoveProgress(0.05, 'Downloading image for background removal...');

            const response = await fetch(currentUrl, { mode: 'cors' });
            if (!response.ok) throw new Error(`Failed to load image (${response.status})`);
            const blob = await response.blob();

            updateBrandBgRemoveProgress(0.25, 'Removing background (RMBG-1.4 AI)...');
            const resultBlob = await BgRemove.removeBackground(blob, {
              maxDimension: 4096,
              onProgress: (p) => {
                const prog = extractProgressPct(p);
                const status = extractStatusMessage(p, `Removing background... ${Math.round(prog * 100)}%`);
                updateBrandBgRemoveProgress(prog, status);
              }
            });

            updateBrandBgRemoveProgress(0.85, 'Uploading transparent image to Cloudinary...');
            const cleanName = `brand_nobg_${Date.now()}.png`;
            const resultFile = new File([resultBlob], cleanName, { type: 'image/png' });

            const formData = new FormData();
            formData.append('file', resultFile);

            const uploadRes = await fetch('/api/upload-image', {
              method: 'POST',
              body: formData
            });

            const uploadResult = await uploadRes.json();
            if (!uploadRes.ok || !uploadResult.success) {
              throw new Error(uploadResult.error || 'Failed to upload background-removed image');
            }

            const newUrl = uploadResult.url || uploadResult.urls?.[0];
            if (!newUrl) throw new Error('No URL returned from upload');

            document.getElementById('brand_image_url').value = newUrl;
            updateBrandPreview(newUrl);
            alert('✓ Background removed successfully! Brand logo updated.');
          } catch (err) {
            console.error('Remove BG failed:', err);
            alert('✕ Background removal failed: ' + err.message);
          } finally {
            showBrandBgRemoveProgress(false);
            isBrandRemovingBg = false;
            brandRemoveBgBtn.disabled = false;
            brandRemoveBgBtn.innerHTML = origBtnText;
            updateBrandSubmitState();
          }
        });
      }

      function renderBrands(filter = '') {
        const container = document.getElementById('brands-container');
        
        const filteredBrands = brands.filter(b => {
          const name = (b.name || '').toLowerCase();
          const category = (b.category || '').toLowerCase();
          return name.includes(filter) || category.includes(filter);
        });

        if (filteredBrands.length === 0) {
          container.innerHTML = filter 
            ? `<div style="grid-column: 1/-1; text-align: center; padding: 2rem; color: var(--text-secondary);">No brands matching "${filter}"</div>`
            : '<div>No brands found. Add one!</div>';
          return;
        }
        
        container.innerHTML = filteredBrands.map(b => `
          <div class="brand-card">
            <div class="brand-header">
              <img src="${b.imageUrl || 'https://via.placeholder.com/50'}" alt="${b.name}" class="brand-logo">
              <div class="brand-info">
                <h3>${b.name}</h3>
                <p>${b.category}</p>
              </div>
            </div>
            <div class="brand-actions">
              <button class="btn-edit" onclick="editBrand('${b.name}')">Edit</button>
              <button class="btn-delete" onclick="deleteBrand('${b.name}')">Delete</button>
            </div>
          </div>
        `).join('');
      }

      const brandModal = document.getElementById('brand-modal');
      const brandForm = document.getElementById('brand-form');
      const modalTitle = document.getElementById('modal-title');
      const closeBrandModal = document.getElementById('close-modal');

      document.getElementById('add-brand-btn').addEventListener('click', () => {
        brandForm.reset();
        document.getElementById('original_name').value = '';
        populateCategorySelect('');
        updateBrandPreview('');
        document.getElementById('upload_widget_text').textContent = '📤 Upload Image';
        showBrandBgRemoveProgress(false);
        modalTitle.textContent = 'Add Brand';
        brandModal.style.display = 'flex';
      });

      closeBrandModal.addEventListener('click', () => {
        brandModal.style.display = 'none';
      });

      window.editBrand = (name) => {
        const b = brands.find(br => br.name === name);
        if (!b) return;
        document.getElementById('original_name').value = b.name;
        document.getElementById('brand_name').value = b.name;
        // Populate and select current category
        populateCategorySelect(b.category || '');
        document.getElementById('brand_image_url').value = b.imageUrl || '';
        document.getElementById('upload_widget_text').textContent = b.imageUrl ? '✅ Uploaded' : '📤 Upload Image';
        showBrandBgRemoveProgress(false);
        updateBrandPreview(b.imageUrl || '');
        modalTitle.textContent = 'Edit Brand';
        brandModal.style.display = 'flex';
      };

      brandForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (isBrandUploading || isBrandRemovingBg) {
          alert('Please wait for the image upload or background removal to complete.');
          return;
        }
        const oldName = document.getElementById('original_name').value;
        const brand = {
          name: document.getElementById('brand_name').value,
          category: document.getElementById('brand_category').value,
          imageUrl: document.getElementById('brand_image_url').value
        };

        const action = oldName ? 'EDIT' : 'ADD';
        const payload = { action, brand, oldName };

        try {
          const res = await fetch('/api/manage-brands', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (res.ok) {
            brands = data.brands;
            const searchTerm = document.getElementById('brand-search').value.toLowerCase();
            renderBrands(searchTerm);
            brandModal.style.display = 'none';
          } else {
            alert(data.error);
          }
        } catch (err) {
          alert(err.message);
        }
      });

      const deleteModal = document.getElementById('delete-modal');
      const closeDeleteModal = document.getElementById('close-delete-modal');
      const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
      const confirmDeleteBtn = document.getElementById('confirm-delete-btn');
      const reassignSection = document.getElementById('reassign-section');
      const deleteWarning = document.getElementById('delete-warning');
      const reassignSelect = document.getElementById('reassign_brand');

      let deletingBrandName = null;
      let deleteNeedsReassign = false;

      window.deleteBrand = (name) => {
        deletingBrandName = name;
        deleteNeedsReassign = false;
        reassignSection.style.display = 'none';
        deleteWarning.innerHTML = `<p>Are you sure you want to delete <strong>${name}</strong>?</p>`;
        deleteModal.style.display = 'flex';
      };

      const closeDel = () => { deleteModal.style.display = 'none'; };
      closeDeleteModal.addEventListener('click', closeDel);
      cancelDeleteBtn.addEventListener('click', closeDel);

      confirmDeleteBtn.addEventListener('click', async () => {
        const payload = { action: 'DELETE', name: deletingBrandName };
        if (deleteNeedsReassign) {
          payload.reassignTo = reassignSelect.value;
          if (!payload.reassignTo) return alert('Please select a brand to reassign to');
        }

        try {
          const res = await fetch('/api/manage-brands', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          
          const data = await res.json();
          if (res.status === 409) {
            // Dependent products exist
            deleteNeedsReassign = true;
            deleteWarning.innerHTML = `<p style="color:var(--error)">Warning: ${data.dependentProducts.length} product(s) use this brand.</p>`;
            
            // Populate reassign dropdown
            reassignSelect.innerHTML = brands
              .filter(b => b.name !== deletingBrandName)
              .map(b => `<option value="${b.name}">${b.name}</option>`)
              .join('');
            
            reassignSection.style.display = 'block';
          } else if (res.ok) {
            brands = data.brands;
            const searchTerm = document.getElementById('brand-search').value.toLowerCase();
            renderBrands(searchTerm);
            deleteModal.style.display = 'none';
          } else {
            alert(data.error);
          }
        } catch (err) {
          alert(err.message);
        }
      });
    });
  </script>
</AdminLayout>
