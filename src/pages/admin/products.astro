---
export const prerender = false;
// src/pages/admin/products.astro
import AdminLayout from '../../components/AdminLayout.astro';
import { fetchAllProducts } from '../../lib/products';

const allProducts = await fetchAllProducts();

const category = Astro.url.searchParams.get('category');
const subcategory = Astro.url.searchParams.get('subcategory');
const subsub = Astro.url.searchParams.get('subsub');
const addProductParams = new URLSearchParams();

if (category) addProductParams.set('category', category);
if (subcategory) addProductParams.set('subcategory', subcategory);
if (subsub) addProductParams.set('subsub', subsub);

const addProductUrl = addProductParams.toString()
  ? `/admin/add-product?${addProductParams.toString()}`
  : '/admin/add-product';

const filteredProducts = allProducts.filter(product => {
  if (category && product.category !== category) return false;
  if (subcategory && product.subcategory !== subcategory) return false;
  if (subsub && product.subsubcategory !== subsub) return false;
  return true;
});
---

<AdminLayout title="Products Management | Peniel Admin">
  <div class="header-section">
    <div>
      <h1 class="page-title">All Products</h1>
      <p class="subtitle">Manage, edit, or delete existing products in your inventory.</p>
    </div>
    <a href={addProductUrl} class="action-btn primary-btn">
      <span class="icon">➕</span> Add New Product
    </a>
  </div>

  <div class="glass-panel">
    <div class="toolbar" style="display: flex; gap: 1.5rem; align-items: center;">
      <div class="search-box">
        <span class="search-icon">🔍</span>
        <input type="text" id="productSearch" placeholder="Search by name, brand, or part number..." />
      </div>
      <label class="checkbox-label" for="featuredFilter" style="margin: 0; color: #fff; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem;">
        <input type="checkbox" id="featuredFilter" />
        ⭐ Featured Only
      </label>
    </div>

    <div class="table-container">
      <table class="products-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Part Number</th>
            <th>Product Name</th>
            <th>Brand</th>
            <th>Category / Sub</th>
            <th>MRP (₹)</th>
            <th class="actions-col">Actions</th>
          </tr>
        </thead>
        <tbody id="tableBody">
          {filteredProducts.map(product => (
            <tr class="product-row" data-search={`${product.product_name || product.name} ${product.brand} ${product.part_no}`.toLowerCase()} data-featured={product.is_featured === 'true' || product.is_featured === true ? 'true' : 'false'}>
              <td class="img-cell">
                {product.image ? (
                  <img src={product.image} alt={product.name} loading="lazy" />
                ) : (
                  <div class="img-placeholder"></div>
                )}
              </td>
              <td class="mono">{product.part_no}</td>
              <td class="fw-500 name-cell">
                {product.name}
                {(product.is_featured === 'true' || product.is_featured === true) && <span title="Featured Product" style="margin-left:0.5rem; font-size:1.1rem; vertical-align: middle;">⭐</span>}
              </td>
              <td>{product.brand}</td>
              <td class="text-sm text-muted">
                {product.category}
                {product.subcategory && ` > ${product.subcategory}`}
              </td>
              <td class="fw-600">₹{product.price.toFixed(2)}</td>
              <td class="actions-col">
                <button class="icon-btn feature-btn" data-partno={product.part_no} data-featured={product.is_featured === 'true' || product.is_featured === true ? 'true' : 'false'} title={product.is_featured === 'true' || product.is_featured === true ? 'Unfeature Product' : 'Feature Product'}>
                  {product.is_featured === 'true' || product.is_featured === true ? '⭐' : '☆'}
                </button>
                <a href={`/admin/edit-product?id=${product.part_no}`} class="icon-btn edit-btn" title="Edit Product">✏️</a>
                <button class="icon-btn delete-btn" data-partno={product.part_no} title="Delete Product">🗑️</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      
      <div id="noResults" class="no-results" style="display: none;">
        No products match your search.
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteModal" class="modal-overlay" style="display: none;">
    <div class="modal-content glass-panel">
      <h2>Delete Product?</h2>
      <p>Are you sure you want to delete product <strong id="deleteTargetName"></strong>?</p>
      <p class="text-danger">This action cannot be undone and will modify the products.xlsx file.</p>
      
      <div class="modal-actions">
        <button id="cancelDelete" class="modal-btn cancel">Cancel</button>
        <button id="confirmDelete" class="modal-btn danger">Delete</button>
      </div>
    </div>
  </div>

  <script>
    // Filter functionality
    const searchInput = document.getElementById('productSearch');
    const featuredFilter = document.getElementById('featuredFilter');
    const rows = document.querySelectorAll('.product-row');
    const noResults = document.getElementById('noResults');

    let scrollTimeout;

    function filterRows() {
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const showFeaturedOnly = featuredFilter ? featuredFilter.checked : false;
      let visibleCount = 0;
      let firstMatch = null;

      rows.forEach(row => {
        if (!(row instanceof HTMLElement)) return;
        const searchData = row.dataset.search || '';
        const isFeatured = row.dataset.featured === 'true';
        
        const matchesSearch = searchData.includes(query);
        const matchesFeatured = !showFeaturedOnly || isFeatured;

        if (matchesSearch && matchesFeatured) {
          row.style.display = '';
          visibleCount++;
          if (!firstMatch) firstMatch = row;
        } else {
          row.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      // Auto-scroll to first match with a small delay to allow for typing
      if (firstMatch && query.length > 1) {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          firstMatch.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 400);
      }
    }

    if (searchInput) searchInput.addEventListener('input', filterRows);
    if (featuredFilter) featuredFilter.addEventListener('change', filterRows);

    // Feature functionality
    const featureBtns = document.querySelectorAll('.feature-btn');
    featureBtns.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget;
        const partNo = target.dataset.partno;
        const isCurrentlyFeatured = target.dataset.featured === 'true';
        const willBeFeatured = !isCurrentlyFeatured;

        let regenerateAi = 'off';
        let customFeatures = '';

        if (willBeFeatured) {
          const userPrompt = prompt(
            "You are featuring this product! ⭐\n\nWould you like to regenerate its AI description to include a catchy slogan?\n\n- Enter custom keywords/features below to weave them in.\n- Leave blank and click OK to regenerate without custom keywords.\n- Click Cancel to just feature it WITHOUT regenerating AI."
          );
          if (userPrompt !== null) {
            regenerateAi = 'on';
            customFeatures = userPrompt;
          }
        } else {
          const confirmUnfeature = confirm("Are you sure you want to unfeature this product?");
          if (!confirmUnfeature) return;
        }

        const originalText = target.textContent;
        target.textContent = '...';
        target.disabled = true;

        try {
          const response = await fetch(`/api/product/${partNo}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              is_featured: willBeFeatured,
              regenerate_ai: regenerateAi,
              custom_features: customFeatures
            })
          });

          if (response.ok) {
            window.location.reload();
          } else {
            const data = await response.json();
            alert(`Error: ${data.error || 'Failed to update'}`);
            target.textContent = originalText;
            target.disabled = false;
          }
        } catch (error) {
          alert('Network error while updating.');
          target.textContent = originalText;
          target.disabled = false;
        }
      });
    });

    // Delete functionality
    const deleteBtns = document.querySelectorAll('.delete-btn');
    const deleteModal = document.getElementById('deleteModal');
    const cancelDeleteBtn = document.getElementById('cancelDelete');
    const confirmDeleteBtn = document.getElementById('confirmDelete');
    const targetNameEl = document.getElementById('deleteTargetName');
    
    let currentPartNoToDelete = null;

    deleteBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        if (!(target instanceof HTMLButtonElement)) return;
        currentPartNoToDelete = target.dataset.partno;
        if (targetNameEl) targetNameEl.textContent = currentPartNoToDelete;
        if (deleteModal) deleteModal.style.display = 'flex';
      });
    });

    if (cancelDeleteBtn && deleteModal) {
      cancelDeleteBtn.addEventListener('click', () => {
        deleteModal.style.display = 'none';
        currentPartNoToDelete = null;
      });
    }

    if (confirmDeleteBtn && deleteModal) {
      confirmDeleteBtn.addEventListener('click', async () => {
        if (!currentPartNoToDelete) return;
        
        const originalText = confirmDeleteBtn.textContent;
        confirmDeleteBtn.textContent = 'Deleting...';
        confirmDeleteBtn.disabled = true;

        try {
          const response = await fetch(`/api/product/${currentPartNoToDelete}`, {
            method: 'DELETE',
          });

          if (response.ok) {
            // Reload page to reflect changes
            window.location.reload();
          } else {
            const data = await response.json();
            alert(`Error: ${data.error || 'Failed to delete'}`);
            confirmDeleteBtn.textContent = originalText;
            confirmDeleteBtn.disabled = false;
          }
        } catch (error) {
          alert('Network error while deleting.');
          confirmDeleteBtn.textContent = originalText;
          confirmDeleteBtn.disabled = false;
        }
      });
    }
  </script>
</AdminLayout>

<style>
  .header-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: #fff;
  }

  .subtitle {
    color: var(--text-secondary);
    margin: 0;
    font-size: 1.1rem;
  }

  .action-btn {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    border-radius: 12px;
    font-weight: 600;
    transition: all 0.2s;
  }

  .primary-btn {
    background: linear-gradient(135deg, var(--accent), #d4af37);
    color: #000;
    box-shadow: 0 5px 15px rgba(197, 160, 40, 0.2);
  }

  .primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(197, 160, 40, 0.3);
  }

  .toolbar {
    margin-bottom: 1.5rem;
  }

  .search-box {
    position: relative;
    max-width: 400px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
  }

  .search-box input {
    width: 100%;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 0.8rem 1rem 0.8rem 2.5rem;
    color: #fff;
    font-size: 0.95rem;
    transition: all 0.2s;
  }

  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
    background: rgba(0, 0, 0, 0.4);
  }

  .table-container {
    overflow-x: auto;
  }

  .products-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .products-table th {
    padding: 1rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    border-bottom: 2px solid rgba(255, 255, 255, 0.05);
  }

  .products-table td {
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    vertical-align: middle;
  }

  .product-row {
    transition: background 0.2s;
  }

  .product-row:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .img-cell {
    width: 60px;
  }

  .img-cell img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
  }

  .img-placeholder {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
  }

  .mono {
    font-family: monospace;
    color: #cbd5e1;
  }

  .fw-500 { font-weight: 500; }
  .fw-600 { font-weight: 600; color: #fff; }
  .text-sm { font-size: 0.85rem; }
  .text-muted { color: var(--text-secondary); }
  
  .name-cell {
    max-width: 250px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .actions-col {
    text-align: right;
    white-space: nowrap;
  }

  .icon-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
    margin-left: 0.3rem;
  }

  .icon-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  .delete-btn:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.4);
  }

  .no-results {
    padding: 3rem;
    text-align: center;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  /* Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(5px);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-content {
    max-width: 400px;
    width: 100%;
    text-align: center;
  }

  .modal-content h2 {
    margin-top: 0;
    color: #fff;
  }

  .text-danger {
    color: var(--error);
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }

  .modal-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .modal-btn {
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .modal-btn.cancel {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .modal-btn.cancel:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .modal-btn.danger {
    background: var(--error);
    color: #fff;
  }

  .modal-btn.danger:hover {
    background: #dc2626;
  }
</style>
