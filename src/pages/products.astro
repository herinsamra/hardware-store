---
import Layout from '../components/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { fetchAllProducts } from '../lib/products';

interface Product {
  id?: string;
  part_no: string;
  sku: string;
  category: string;
  subcategory: string;
  subsubcategory: string;
  type: string;
  name: string;
  description: string;
  brand: string;
  images: string[];
  image: string;
  thumbnail: string;
  variant_name: string;
  price: number;
  slug: string;
  routeParam: string;
  url: string;
  meta_title: string;
  meta_description: string;
  is_featured?: boolean | string;
  slogan?: string;
  video_url?: string;
}

const baseProducts: Product[] = await fetchAllProducts();
const allProducts: Product[] = [];

baseProducts.forEach(product => {
  allProducts.push(product);

  if (product.variants && product.variants.length > 0) {
    product.variants.forEach(variant => {
      const variantImage = (variant.images && variant.images.length > 0) ? variant.images[0] : product.image;
      
      const siblingVariants = product.variants.filter(v => v.variant_id !== variant.variant_id);
      if (product.variant_name) {
        siblingVariants.unshift({
          variant_id: product.variant_name,
          price: product.price,
          part_no: product.part_no,
          sku: product.sku,
          images: product.images
        });
      }

      allProducts.push({
        ...product,
        id: variant.part_no || `${product.id}-${variant.variant_id}`,
        part_no: variant.part_no || product.part_no,
        sku: variant.sku || product.sku,
        variant_name: variant.variant_id,
        price: variant.price !== undefined ? variant.price : product.price,
        images: variant.images && variant.images.length > 0 ? variant.images : product.images,
        image: variantImage,
        thumbnail: variantImage ? variantImage.replace('/upload/', '/upload/c_fill,w_200,h_200/') : product.thumbnail,
        url: `${product.url}?variant=${encodeURIComponent(variant.variant_id)}`,
        variants: siblingVariants
      });
    });
  }
});
const productsPerPage = 12;
---

<Layout title="Products | Peniel Hardwares">
  <div class="products-page">
    <h1 class="page-title" id="products-page-title">All Products</h1>
    <p class="product-count" id="product-count">Loading products...</p>

    <div class="product-grid" id="product-grid">
      <!-- Skeleton cards shown until JS renders real products -->
      {Array.from({ length: 12 }).map(() => (
        <div class="product-card skeleton-card" aria-hidden="true">
          <div class="product-image-wrapper skeleton-img"></div>
          <div class="product-info">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line skeleton-subtitle"></div>
            <div class="skeleton-line skeleton-price"></div>
            <div class="skeleton-line skeleton-category"></div>
          </div>
        </div>
      ))}
    </div>

    <div class="no-results" id="no-results" hidden>
      <p>No products found. Try a different filter or search term.</p>
    </div>

    <div id="infinite-scroll-trigger" class="scroll-trigger"></div>

    <noscript>
      <p class="product-count">
        JavaScript is required for URL-based filtering on this static build. Showing all products instead.
      </p>
      <div class="product-grid">
        {allProducts.map(product => (
          <ProductCard product={product} />
        ))}
      </div>
    </noscript>
  </div>

  <script
    id="products-page-data"
    type="application/json"
    set:html={JSON.stringify({ allProducts, productsPerPage })}
  />

  <script>
    import Fuse from 'fuse.js';

    const productsPageDataEl = document.getElementById('products-page-data');
    if (!(productsPageDataEl instanceof HTMLScriptElement) || !productsPageDataEl.textContent) {
      throw new Error('Products page data is missing.');
    }

    const { allProducts, productsPerPage } = JSON.parse(productsPageDataEl.textContent);

    const cleanName = (value = '') => value.replace(/_/g, ' ');
    const normalizeText = value => (value || '').toString().toLowerCase();
    const productKey = product => product.routeParam || product.slug || product.id || product.url || product.name;

    const titleEl = document.getElementById('products-page-title');
    const countEl = document.getElementById('product-count');
    const gridEl = document.getElementById('product-grid');
    const noResultsEl = document.getElementById('no-results');
    const triggerEl = document.getElementById('infinite-scroll-trigger');
    const searchForm = document.querySelector('.header-search');
    const searchInput = document.querySelector('.header-search-input');

    const params = new URLSearchParams(window.location.search);
    const filters = {
      category: params.get('category') || '',
      subcategory: params.get('subcategory') || '',
      subsub: params.get('subsub') || '',
      brand: params.get('brand') || '',
    };

    const state = {
      search: (params.get('search') || '').trim(),
      page: 1, 
      suggestionsOpen: false,
    };

    const searchableKeys = [
      'name',
      'variant_name',
      'brand',
      'part_no',
      'sku',
      'category',
      'subcategory',
      'subsubcategory',
      'description',
    ];

    const getSeed = () => {
      let seedStr = sessionStorage.getItem('productShuffleSeed');
      if (!seedStr) {
        seedStr = Math.floor(Math.random() * 1000000).toString();
        sessionStorage.setItem('productShuffleSeed', seedStr);
      }
      return parseInt(seedStr, 10);
    };

    const shuffleArray = (array, seed = getSeed()) => {
      const newArray = [...array];
      let currentSeed = seed;
      const nextRandom = () => {
        currentSeed = (currentSeed * 9301 + 49297) % 233280;
        return currentSeed / 233280;
      };

      for (let i = newArray.length - 1; i > 0; i--) {
        const j = Math.floor(nextRandom() * (i + 1));
        [newArray[i], newArray[j]] = [newArray[j], newArray[i]];
      }
      return newArray;
    };

    const rawFilteredProducts = allProducts.filter(product => {
      if (filters.category && product.category !== filters.category) return false;
      if (filters.subcategory && product.subcategory !== filters.subcategory) return false;
      if (filters.subsub && product.subsubcategory !== filters.subsub) return false;
      if (filters.brand && product.brand !== filters.brand) return false;
      return true;
    });

    const structureFilteredProducts = shuffleArray(rawFilteredProducts);

    const fuse = new Fuse(structureFilteredProducts, {
      includeScore: true,
      includeMatches: true,
      threshold: 0.34,
      ignoreLocation: true,
      shouldSort: true,
      minMatchCharLength: 2,
      keys: [
        { name: 'name', weight: 0.35 },
        { name: 'variant_name', weight: 0.16 },
        { name: 'brand', weight: 0.15 },
        { name: 'part_no', weight: 0.1 },
        { name: 'sku', weight: 0.08 },
        { name: 'category', weight: 0.07 },
        { name: 'subcategory', weight: 0.04 },
        { name: 'subsubcategory', weight: 0.02 },
        { name: 'description', weight: 0.03 },
      ],
    });

    const updateSearchForm = () => {
      if (searchInput instanceof HTMLInputElement) {
        searchInput.value = state.search;
      }
    };

    const formatPrice = value => {
      const amount = Number(value);
      if (!Number.isFinite(amount)) return '0.00';
      
      // Format using Indian numbering system
      const integerPart = Math.floor(Math.abs(amount)).toString();
      if (amount < 1000) {
        return integerPart;
      }
      
      const lastThree = integerPart.slice(-3);
      const rest = integerPart.slice(0, -3);
      const restFormatted = rest.replace(/\B(?=(\d{2})+(?!\d))/g, ',');
      const formattedInteger = rest.length > 0 ? `${restFormatted},${lastThree}` : lastThree;
      
      return formattedInteger;
    };

    const buildPageUrl = () => {
      const nextParams = new URLSearchParams();

      Object.entries(filters).forEach(([key, value]) => {
        if (!value) return;
        nextParams.set(key, value);
      });

      if (state.search.trim()) {
        nextParams.set('search', state.search.trim());
      }

      const query = nextParams.toString();
      return query ? `?${query}` : '/products';
    };

    const getPageTitle = () => {
      if (state.search) return `Search: "${state.search}"`;
      if (filters.brand) return `${cleanName(filters.brand)} Products`;
      if (filters.subsub) return cleanName(filters.subsub);
      if (filters.subcategory) return cleanName(filters.subcategory);
      if (filters.category) return `${cleanName(filters.category)} Products`;
      return 'All Products';
    };

    const normalizeIndices = indices => {
      if (!Array.isArray(indices) || indices.length === 0) return [];
      const sorted = [...indices].sort((a, b) => a[0] - b[0]);
      const merged = [[sorted[0][0], sorted[0][1]]];

      for (let index = 1; index < sorted.length; index += 1) {
        const [start, end] = sorted[index];
        const previous = merged[merged.length - 1];

        if (start <= previous[1] + 1) {
          previous[1] = Math.max(previous[1], end);
        } else {
          merged.push([start, end]);
        }
      }

      return merged;
    };

    const setHighlightedText = (element, value, indices = []) => {
      const displayValue = cleanName(value || '');
      element.replaceChildren();

      if (!displayValue) return;

      const ranges = normalizeIndices(indices);
      if (ranges.length === 0) {
        element.textContent = displayValue;
        return;
      }

      let cursor = 0;

      ranges.forEach(([start, end]) => {
        if (start > cursor) {
          element.appendChild(document.createTextNode(displayValue.slice(cursor, start)));
        }

        const mark = document.createElement('mark');
        mark.className = 'search-highlight';
        mark.textContent = displayValue.slice(start, end + 1);
        element.appendChild(mark);
        cursor = end + 1;
      });

      if (cursor < displayValue.length) {
        element.appendChild(document.createTextNode(displayValue.slice(cursor)));
      }
    };

    const buildMatchInfo = matches => {
      const matchInfo = {};

      (matches || []).forEach(match => {
        if (!match || typeof match.key !== 'string' || !Array.isArray(match.indices)) return;
        matchInfo[match.key] = normalizeIndices(match.indices);
      });

      return matchInfo;
    };

    const buildFallbackMatchInfo = (product, query) => {
      const normalizedQuery = normalizeText(query);
      const matchInfo = {};

      searchableKeys.forEach(key => {
        const value = product[key];
        const normalizedValue = normalizeText(value);
        if (!normalizedValue || !normalizedQuery) return;

        const indices = [];
        let startIndex = normalizedValue.indexOf(normalizedQuery);

        while (startIndex !== -1) {
          indices.push([startIndex, startIndex + normalizedQuery.length - 1]);
          startIndex = normalizedValue.indexOf(normalizedQuery, startIndex + normalizedQuery.length);
        }

        if (indices.length > 0) {
          matchInfo[key] = indices;
        }
      });

      return matchInfo;
    };

    const getSearchData = () => {
      const query = state.search.trim();
      if (!query) {
        return {
          products: structureFilteredProducts,
          matchMap: new Map(),
          query: '',
        };
      }

      if (query.length < 2) {
        const normalizedQuery = normalizeText(query);
        const products = structureFilteredProducts.filter(product =>
          searchableKeys.some(key => normalizeText(product[key]).includes(normalizedQuery))
        );

        const matchMap = new Map(
          products.map(product => [productKey(product), buildFallbackMatchInfo(product, query)])
        );

        return {
          products,
          matchMap,
          query,
        };
      }

      const results = fuse.search(query);
      const matchMap = new Map();

      results.forEach(result => {
        matchMap.set(productKey(result.item), buildMatchInfo(result.matches));
      });

      return {
        products: results.map(result => result.item),
        matchMap,
        query,
      };
    };

    const getMatchContext = (product, matchInfo) => {
      const contextFields = [
        ['brand', 'Brand'],
        ['part_no', 'Part No'],
        ['sku', 'SKU'],
        ['subcategory', 'Subcategory'],
        ['subsubcategory', 'Range'],
      ];

      for (const [key, label] of contextFields) {
        if (matchInfo[key]?.length && product[key]) {
          return { key, label, value: product[key], indices: matchInfo[key] };
        }
      }

      return null;
    };

    const isFeaturedProduct = product => {
      const value = product?.is_featured;
      return value === true || String(value || '').toLowerCase() === 'true';
    };

    const getVideoUrl = product => {
      const url = product?.video_url;
      return typeof url === 'string' ? url.trim() : '';
    };

    const getFeaturedProduct = (featuredProducts, usedFeaturedKeys) => {
      if (!featuredProducts.length) return null;

      const freshPick = featuredProducts.find(product => !usedFeaturedKeys.has(productKey(product)));
      return freshPick || featuredProducts[usedFeaturedKeys.size % featuredProducts.length];
    };

    const getCreativeSlogan = (product) => {
      if (product.slogan) return product.slogan;
      const name = (product.name || '').toLowerCase();
      const category = (product.category || '').toLowerCase();
      
      if (name.includes('fan') || category.includes('fan')) return `Beat the summer heat with this powerful ${product.name}!`;
      if (name.includes('pump') || category.includes('pump')) return `Reliable performance you can trust. Upgrade to ${product.name}.`;
      if (name.includes('cable') || category.includes('cable')) return `Seamless connectivity starts here with ${product.brand || 'premium'} cables.`;
      if (name.includes('switch') || category.includes('switch')) return `Modernize your space with elegant ${product.brand || 'new'} switches.`;
      if (name.includes('light') || category.includes('light')) return `Brighten up your world with energy-efficient ${product.name}.`;
      
      const slogans = [
        `Experience the ultimate quality with ${product.name}.`,
        `Don't miss out on this premium ${cleanName(product.category) || 'product'}!`,
        `Upgrade your toolkit with the best-in-class ${product.name}.`,
        `Exceptional performance meets stunning design.`,
        `Our top pick for professionals.`
      ];
      let hash = 0;
      for(let i=0; i<name.length; i++) hash += name.charCodeAt(i);
      return slogans[hash % slogans.length];
    };

    const createFeaturedCard = (product, variantIndex = 0) => {
      const videoUrl = getVideoUrl(product);
      let variant = variantIndex % 4;
      if (videoUrl) {
        variant = 3;
      } else if (variant === 3) {
        variant = 1;
      }
      
      const card = document.createElement('a');
      card.href = product.url || `/product/${product.id}`;
      card.className = `featured-product-card featured-variant-${variant} group`;
      card.setAttribute('data-astro-prefetch', '');

      const contentWrapper = document.createElement('div');
      contentWrapper.className = 'featured-content';

      if (variant !== 3) {
        const badge = document.createElement('span');
        badge.className = 'featured-badge';
        badge.textContent = 'Featured Pick';
        contentWrapper.appendChild(badge);

        const kicker = document.createElement('p');
        kicker.className = 'featured-kicker';
        kicker.textContent = [product.brand, cleanName(product.category)].filter(Boolean).join(' / ');
        contentWrapper.appendChild(kicker);

        const slogan = document.createElement('h3');
        slogan.className = 'featured-slogan';
        slogan.textContent = getCreativeSlogan(product);
        contentWrapper.appendChild(slogan);

        const name = document.createElement('p');
        name.className = 'featured-name';
        name.textContent = product.name;
        contentWrapper.appendChild(name);
      }

      const details = document.createElement('div');
      details.className = 'featured-details';

      if (variant !== 3 && Number.isFinite(Number(product.price))) {
        const price = document.createElement('span');
        price.className = 'featured-price';
        price.textContent = `MRP: ₹${formatPrice(product.price)}`;
        details.appendChild(price);
      }

      const action = document.createElement('span');
      action.className = 'featured-action';
      action.textContent = variant === 1 ? 'Explore' : variant === 2 ? 'See details' : 'View product';
      details.appendChild(action);
      contentWrapper.appendChild(details);

      const imageWrapper = document.createElement('div');
      imageWrapper.className = 'featured-image-wrapper';

      if (variant === 3 && videoUrl) {
        const video = document.createElement('video');
        video.src = videoUrl;
        video.autoplay = true;
        video.muted = true;
        video.loop = true;
        video.playsInline = true;
        video.preload = 'metadata';
        video.setAttribute('muted', '');
        video.setAttribute('playsinline', '');
        video.className = 'featured-video';
        imageWrapper.appendChild(video);
        
        const overlay = document.createElement('div');
        overlay.className = 'featured-video-overlay';
        imageWrapper.appendChild(overlay);
      } else if (product.image) {
        const image = document.createElement('img');
        image.src = product.image;
        image.alt = product.name;
        image.className = 'featured-image';
        image.loading = 'lazy';
        imageWrapper.appendChild(image);
      }

      card.appendChild(contentWrapper);
      card.appendChild(imageWrapper);

      if (variant === 0) {
        const strip = document.createElement('div');
        strip.className = 'featured-accent featured-marquee-strip';
        strip.setAttribute('aria-hidden', 'true');

        const track = document.createElement('div');
        track.className = 'featured-marquee-track';

        const phrase = ` SUPER SALE • BEST OFFER • PREMIUM PICK • `;
        [0, 1].forEach(() => {
          const text = document.createElement('span');
          text.textContent = phrase.repeat(4);
          track.appendChild(text);
        });

        strip.appendChild(track);
        card.appendChild(strip);
      } else if (variant === 1) {
        const accent = document.createElement('div');
        accent.className = 'featured-accent featured-edge-accent';
        accent.setAttribute('aria-hidden', 'true');

        const frame = document.createElement('div');
        frame.className = 'featured-edge-frame';

        const labelWrapper = document.createElement('div');
        labelWrapper.className = 'featured-edge-label-wrapper';
        
        const label = document.createElement('span');
        label.className = 'featured-edge-label';
        label.textContent = 'SUPER SALE';
        
        labelWrapper.appendChild(label);
        accent.appendChild(frame);
        accent.appendChild(labelWrapper);
        card.appendChild(accent);
      } else if (variant === 2) {
        const svgNS = 'http://www.w3.org/2000/svg';
        const key = String(productKey(product) || `featured-${variantIndex}`).replace(/[^a-z0-9_-]/gi, '-');
        const pathId = `featured-seal-${key}-${variantIndex}`;

        const seal = document.createElementNS(svgNS, 'svg');
        seal.classList.add('featured-accent', 'featured-seal');
        seal.setAttribute('viewBox', '0 0 150 150');
        seal.setAttribute('aria-hidden', 'true');

        const defs = document.createElementNS(svgNS, 'defs');
        const path = document.createElementNS(svgNS, 'path');
        path.setAttribute('id', pathId);
        path.setAttribute('d', 'M 75, 75 m -50, 0 a 50,50 0 1,1 100,0 a 50,50 0 1,1 -100,0');
        defs.appendChild(path);

        const circle = document.createElementNS(svgNS, 'circle');
        circle.setAttribute('cx', '75');
        circle.setAttribute('cy', '75');
        circle.setAttribute('r', '38');
        circle.setAttribute('class', 'featured-seal-core');

        const rotatingGroup = document.createElementNS(svgNS, 'g');
        rotatingGroup.setAttribute('class', 'featured-seal-rotating');
        
        const text = document.createElementNS(svgNS, 'text');
        text.setAttribute('class', 'featured-seal-text');
        const textPath = document.createElementNS(svgNS, 'textPath');
        textPath.setAttribute('href', `#${pathId}`);
        textPath.textContent = 'SALE • SALE • SALE • SALE • SALE • SALE • ';
        text.appendChild(textPath);
        
        rotatingGroup.appendChild(text);

        const center = document.createElementNS(svgNS, 'text');
        center.setAttribute('x', '75');
        center.setAttribute('y', '73');
        center.setAttribute('text-anchor', 'middle');
        center.setAttribute('class', 'featured-seal-mark');
        center.textContent = 'BEST';
        
        const center2 = document.createElementNS(svgNS, 'text');
        center2.setAttribute('x', '75');
        center2.setAttribute('y', '92');
        center2.setAttribute('text-anchor', 'middle');
        center2.setAttribute('class', 'featured-seal-mark-sub');
        center2.textContent = 'OFFER';

        seal.appendChild(defs);
        seal.appendChild(circle);
        seal.appendChild(rotatingGroup);
        seal.appendChild(center);
        seal.appendChild(center2);

        card.appendChild(seal);
      }

      return card;
    };

    const createProductCard = (product, matchInfo = {}) => {
      const productHref = product.url || `/product/${product.id}`;
      const card = document.createElement('div');
      card.className = 'product-card group';
      card.dataset.href = productHref;
      card.setAttribute('data-astro-prefetch', '');
      card.addEventListener('click', (e) => {
        if (e.target.closest('.card-variant-chip')) return;
        window.location.href = productHref;
      });

      const imageWrapper = document.createElement('div');
      imageWrapper.className = 'product-image-wrapper';

      if (product.image) {
        const image = document.createElement('img');
        image.src = product.image;
        image.alt = product.name;
        image.className = 'product-image';
        image.loading = 'lazy';
        imageWrapper.appendChild(image);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'product-image-placeholder';

        const placeholderText = document.createElement('span');
        placeholderText.textContent = 'No Image';
        placeholder.appendChild(placeholderText);
        imageWrapper.appendChild(placeholder);
      }

      const info = document.createElement('div');
      info.className = 'product-info';

      const name = document.createElement('h3');
      name.className = 'product-name';
      setHighlightedText(name, product.name || 'Unnamed Product', matchInfo.name || []);
      info.appendChild(name);

      // We now show variants as chips instead of a single text line below the name
      // This matches the new ProductCard.astro behavior
      const matchContext = getMatchContext(product, matchInfo);
      if (matchContext) {
        const matchLine = document.createElement('p');
        matchLine.className = 'product-match';
        matchLine.appendChild(document.createTextNode(`${matchContext.label}: `));

        const matchValue = document.createElement('span');
        setHighlightedText(matchValue, matchContext.value, matchContext.indices);
        matchLine.appendChild(matchValue);
        info.appendChild(matchLine);
      }

      if (product.price && Number(product.price) > 0) {
        const price = document.createElement('div');
        price.className = 'product-price';
        price.textContent = `MRP: ₹${formatPrice(product.price)}`;
        info.appendChild(price);
      }

      if (product.variants && product.variants.length > 0) {
        const pillsWrapper = document.createElement('div');
        pillsWrapper.className = 'card-variant-pills';
        const productHref = product.url || `/product/${product.id}`;

        if (product.variant_name) {
          const activeChip = document.createElement('a');
          activeChip.className = 'card-variant-chip active';
          activeChip.textContent = cleanName(product.variant_name);
          activeChip.href = productHref;
          activeChip.addEventListener('click', e => e.stopPropagation());
          pillsWrapper.appendChild(activeChip);
        }

        const visibleVariants = product.variants.slice(0, 4);
        visibleVariants.forEach(v => {
          const chip = document.createElement('a');
          chip.className = 'card-variant-chip';
          chip.textContent = v.variant_id;
          const baseUrl = productHref.split('?')[0];
          chip.href = `${baseUrl}?variant=${encodeURIComponent(v.variant_id)}`;
          chip.addEventListener('click', e => e.stopPropagation());
          pillsWrapper.appendChild(chip);
        });

        if (product.variants.length > 4) {
          const moreChip = document.createElement('a');
          moreChip.className = 'card-variant-chip more';
          moreChip.textContent = '+' + (product.variants.length - 4);
          moreChip.href = productHref;
          moreChip.addEventListener('click', e => e.stopPropagation());
          pillsWrapper.appendChild(moreChip);
        }

        info.appendChild(pillsWrapper);
      }

      const brand = document.createElement('div');
      brand.className = 'product-category';
      brand.setAttribute('aria-label', `Brand: ${cleanName(product.brand || '')}`);
      setHighlightedText(brand, product.brand || product.category || '', matchInfo.brand || []);
      info.appendChild(brand);

      card.appendChild(imageWrapper);
      card.appendChild(info);

      return card;
    };

    let observer = null;
    let itemsRendered = 0;
    let usedFeaturedKeys = new Set();
    let currentSearchData = null;

    const renderProducts = (replaceHistory = true, append = false) => {
      if (!titleEl || !countEl || !gridEl || !noResultsEl || !triggerEl) return;

      if (!append) {
        currentSearchData = getSearchData();
        state.page = 1;
        itemsRendered = 0;
        usedFeaturedKeys = new Set();
        gridEl.replaceChildren();
      }

      const searchData = currentSearchData;
      const filteredProducts = searchData.products;
      const totalProducts = filteredProducts.length;
      
      const startIndex = (state.page - 1) * productsPerPage;
      const paginatedProducts = filteredProducts.slice(startIndex, startIndex + productsPerPage);
      const pageTitle = getPageTitle();

      if (!append) {
        titleEl.textContent = pageTitle;
        countEl.textContent = `${totalProducts} product${totalProducts !== 1 ? 's' : ''} found`;
        document.title = `${pageTitle} | Peniel Hardwares`;
      }

      if (paginatedProducts.length > 0) {
        const shuffledFeatured = shuffleArray(
          structureFilteredProducts.filter(isFeaturedProduct),
          getSeed() + state.page + state.search.length
        );

        const injectFeatured = () => {
          const featuredProduct = getFeaturedProduct(shuffledFeatured, usedFeaturedKeys);
          if (!featuredProduct) return false;

          const variantIndex = usedFeaturedKeys.size;
          usedFeaturedKeys.add(productKey(featuredProduct));
          gridEl.appendChild(createFeaturedCard(featuredProduct, variantIndex));
          return true;
        };

        paginatedProducts.forEach((product) => {
          if (itemsRendered > 0 && itemsRendered % 4 === 0) {
            injectFeatured();
          }

          const matchInfo = searchData.matchMap.get(productKey(product)) || {};
          gridEl.appendChild(createProductCard(product, matchInfo));
          itemsRendered++;
        });

        if (itemsRendered > 0 && itemsRendered < 5 && !append) {
          injectFeatured();
        }

        noResultsEl.hidden = true;
        gridEl.hidden = false;
        
        // Setup observer for next page
        if (startIndex + productsPerPage < totalProducts) {
          triggerEl.hidden = false;
          setupObserver();
        } else {
          triggerEl.hidden = true;
        }

      } else if (!append) {
        noResultsEl.hidden = false;
        gridEl.hidden = true;
        triggerEl.hidden = true;
      }

      if (replaceHistory && !append) {
        window.history.replaceState({}, '', buildPageUrl());
      }
    };

    const setupObserver = () => {
      if (observer) {
        observer.disconnect();
      }
      observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          state.page++;
          renderProducts(false, true);
        }
      }, { rootMargin: '200px' });
      observer.observe(triggerEl);
    };

    if (searchForm instanceof HTMLFormElement && searchInput instanceof HTMLInputElement) {
      searchInput.addEventListener('input', () => {
        state.search = searchInput.value;
        renderProducts(true, false);
      });

      searchForm.addEventListener('submit', event => {
        event.preventDefault();
        state.search = searchInput.value.trim();
        renderProducts(true, false);
        if (typeof gtag === 'function' && state.search) gtag('event', 'search', { search_term: state.search });
      });
    }

    updateSearchForm();
    renderProducts(false);
  </script>
</Layout>

